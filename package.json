{
  "name": "clinicalcraft",
  "version": "5.0.0",
  "private": true,
  "description": "ClinicalCraft \u2014 an agent framework for LLM-driven virtual patients in a voxel clinical world",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/core",
    "packages/content",
    "packages/agent",
    "packages/cli",
    "packages/server",
    "packages/mcp",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:web",
    "build:lib": "tsc -b packages/core packages/content packages/agent packages/cli packages/server packages/mcp",
    "build:web": "npm run build -w @clinicalcraft/web",
    "build:standalone": "npm run build:standalone -w @clinicalcraft/web",
    "typecheck": "tsc -b packages/core packages/content packages/agent packages/cli packages/server packages/mcp && npm run typecheck -w @clinicalcraft/web",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e -w @clinicalcraft/web",
    "dev": "npm run dev -w @clinicalcraft/web",
    "cc": "tsx packages/cli/src/bin.ts",
    "validate:content": "tsx packages/cli/src/bin.ts case validate --all",
    "schemas": "tsx scripts/gen-json-schemas.ts",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "4.1.11",
    "zod-to-json-schema": "3.24.6"
  },
  "overrides": {
    "vite": "6.4.4"
  }
}
