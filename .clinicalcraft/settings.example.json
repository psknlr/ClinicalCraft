{
  "provider": "anthropic",
  "model": "claude-opus-5-5",
  "agents": {
    "patient": { "provider": "zhipu", "model": "glm-4.6", "effort": "low" },
    "nurse": { "provider": "xai", "model": "grok-4.6" },
    "examiner": { "provider": "anthropic", "model": "claude-opus-5-5", "effort": "high" }
  },
  "providers": {
    "my-gateway": { "wire": "openai-chat-completions", "baseUrl": "https://llm.example.edu/v1", "apiKeyEnv": ["SCHOOL_LLM_KEY"], "defaultModel": "glm-4.6" }
  },
  "hooks": {
    "ClinicalEvent": [
      { "matcher": "objective\\.completed|case\\.finished", "hooks": [{ "type": "command", "command": "node .clinicalcraft/hooks/log-progress.mjs", "timeout": 10 }] }
    ],
    "PreToolUse": [
      { "matcher": "intervene", "hooks": [{ "type": "command", "command": "node .clinicalcraft/hooks/double-check-high-risk.mjs", "timeout": 10 }] }
    ]
  }
}
