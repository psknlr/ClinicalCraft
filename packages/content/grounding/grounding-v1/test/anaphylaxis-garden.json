{
  "$schema": "../../../schemas/grounding-set.schema.json",
  "format": "clinicalcraft/grounding-set@1",
  "suite": "grounding-v1",
  "split": "test",
  "caseId": "anaphylaxis-garden",
  "history": [
    { "id": "ana-t-h01", "locale": "en", "text": "What's going on?", "expect": ["pc-sting"] },
    { "id": "ana-t-h02", "locale": "en", "text": "How quickly did all this come on after the sting?", "expect": ["hpi-onset"] },
    { "id": "ana-t-h03", "locale": "en", "text": "Is it hard to swallow?", "expect": ["hpi-throat"] },
    { "id": "ana-t-h04", "locale": "en", "text": "Are you wheezy?", "expect": ["hpi-breathing"] },
    { "id": "ana-t-h05", "locale": "en", "text": "Do you feel faint?", "expect": ["hpi-dizzy"] },
    { "id": "ana-t-h06", "locale": "en", "text": "Did you black out?", "expect": ["hpi-loc"] },
    { "id": "ana-t-h07", "locale": "en", "text": "Is your tongue swelling up?", "expect": ["hpi-lips-tongue"] },
    { "id": "ana-t-h08", "locale": "en", "text": "Have you had any tummy cramps or been sick?", "expect": ["hpi-gi"] },
    { "id": "ana-t-h09", "locale": "en", "text": "Where did it get you?", "expect": ["hpi-sting-site"] },
    { "id": "ana-t-h10", "locale": "en", "text": "Have you reacted badly to a sting before?", "expect": ["prev-reaction"] },
    { "id": "ana-t-h11", "locale": "en", "text": "Do you have an EpiPen with you?", "expect": ["aai-own"] },
    { "id": "ana-t-h12", "locale": "en", "text": "Is there any chance you're pregnant?", "expect": ["obstetric-lmp"] },
    { "id": "ana-t-h13", "locale": "en", "text": "Are you on any beta-blockers?", "expect": ["meds-bb"], "alsoOk": ["meds"] },
    { "id": "ana-t-h14", "locale": "en", "text": "When was your last tetanus jab?", "expect": ["unknown-tetanus"] },
    { "id": "ana-t-h15", "locale": "en", "text": "How's your breathing now?", "phase": "ed", "expect": ["now-breathing-ed"], "alsoOk": ["status-ed"] },
    { "id": "ana-t-h16", "locale": "en", "text": "What's your favourite colour?", "expect": [] },
    { "id": "ana-t-h17", "locale": "en", "text": "Have you ever lived abroad?", "expect": [] },
    { "id": "ana-t-h18", "locale": "zh-CN", "text": "被什么蜇的？", "expect": ["hpi-insect"] },
    { "id": "ana-t-h19", "locale": "zh-CN", "text": "身上痒不痒？有没有起风团？", "expect": ["hpi-itch-rash"] },
    { "id": "ana-t-h20", "locale": "zh-CN", "text": "心跳得快吗？胸口疼吗？", "expect": ["hpi-chest-palp"] },
    { "id": "ana-t-h21", "locale": "zh-CN", "text": "被蜇之前吃过什么东西或者吃过药吗？", "expect": ["hpi-other-triggers"], "alsoOk": ["meds"] },
    { "id": "ana-t-h22", "locale": "zh-CN", "text": "有哮喘吗？", "expect": ["pmh-asthma"] },
    { "id": "ana-t-h23", "locale": "zh-CN", "text": "以前开过刀没有？", "expect": ["psh"] },
    { "id": "ana-t-h24", "locale": "zh-CN", "text": "有没有对哪种药过敏？", "expect": ["allergy-drug"] },
    { "id": "ana-t-h25", "locale": "zh-CN", "text": "平时在吃什么药？", "expect": ["meds"] },
    { "id": "ana-t-h26", "locale": "zh-CN", "text": "你体重多少公斤？", "expect": ["weight"] },
    { "id": "ana-t-h27", "locale": "zh-CN", "text": "你在哪儿上班？", "expect": ["social-occupation"] },
    { "id": "ana-t-h28", "locale": "zh-CN", "text": "你吸烟吗？", "expect": ["social-habits"] },
    { "id": "ana-t-h29", "locale": "zh-CN", "text": "家里有人养蜜蜂吗？", "expect": ["social-bees"] },
    { "id": "ana-t-h30", "locale": "zh-CN", "text": "做过过敏原测试吗？", "expect": ["prior-testing"] },
    { "id": "ana-t-h31", "locale": "zh-CN", "text": "你最怕的是什么？", "expect": ["ice-concern"] },
    { "id": "ana-t-h32", "locale": "zh-CN", "text": "你几点睡觉？", "expect": [] },
    { "id": "ana-t-h33", "locale": "zh-CN", "text": "你家养猫吗？", "expect": [] },
    { "id": "ana-t-n01", "locale": "en", "text": "You didn't faint, did you?", "expect": ["hpi-loc"], "alsoOk": ["hpi-dizzy"], "tags": ["negation"] },
    { "id": "ana-t-n02", "locale": "zh-CN", "text": "你身上没带肾上腺素笔吧？", "expect": ["aai-own"], "tags": ["negation"] }
  ],
  "exam": [
    { "id": "ana-t-e01", "locale": "en", "query": "look in her mouth and listen to her voice", "expect": "ex-airway-scene" },
    { "id": "ana-t-e02", "locale": "en", "itemId": "auscultate-lungs", "expect": "ex-chest-scene" },
    { "id": "ana-t-e03", "locale": "en", "query": "check her pulse and cap refill", "expect": "ex-circ-scene" },
    { "id": "ana-t-e04", "locale": "en", "query": "look at the sting on her arm", "expect": "ex-sting-site" },
    { "id": "ana-t-e05", "locale": "en", "query": "listen to her chest", "phase": "ed", "expect": "ex-chest-ed" },
    { "id": "ana-t-e06", "locale": "zh-CN", "query": "看看身上的皮疹", "expect": "ex-skin" },
    { "id": "ana-t-e07", "locale": "zh-CN", "query": "翻一下她的包，看有没有肾上腺素笔", "expect": "ex-belongings" },
    { "id": "ana-t-e08", "locale": "zh-CN", "query": "观察呼吸费不费力", "expect": "ex-wob-scene" }
  ],
  "orders": [
    { "id": "ana-t-o01", "locale": "en", "query": "mast cell tryptase now", "expect": "tryptase-1" },
    { "id": "ana-t-o02", "locale": "en", "itemId": "pregnancy-test", "expect": "upt" },
    { "id": "ana-t-o03", "locale": "en", "query": "venous gas with lactate", "expect": "vbg" },
    { "id": "ana-t-o04", "locale": "en", "query": "allergy skin prick testing", "expect": null },
    { "id": "ana-t-o05", "locale": "zh-CN", "query": "查个血常规", "expect": "fbc" },
    { "id": "ana-t-o06", "locale": "zh-CN", "query": "床旁测个血糖", "expect": "poc-glucose" },
    { "id": "ana-t-o07", "locale": "zh-CN", "query": "拍个胸片", "expect": "cxr" },
    { "id": "ana-t-o08", "locale": "zh-CN", "query": "1到2小时后再抽一次类胰蛋白酶", "expect": "tryptase-2" },
    { "id": "ana-t-n06", "locale": "en", "query": "pregnancy test to exclude pregnancy", "expect": "upt", "tags": ["negation"] }
  ],
  "interventions": [
    { "id": "ana-t-i01", "locale": "en", "query": "adrenaline 0.5 mg IM into the thigh", "expect": "adrenaline-im" },
    { "id": "ana-t-i02", "locale": "en", "query": "lie her flat and raise her legs", "expect": "position-supine-legs" },
    { "id": "ana-t-i03", "locale": "en", "itemId": "nebulised-salbutamol", "expect": "salbutamol-neb" },
    { "id": "ana-t-i04", "locale": "en", "query": "flick the stinger out", "expect": "remove-sting" },
    { "id": "ana-t-i05", "locale": "en", "query": "give 2 g of IV magnesium", "expect": null },
    { "id": "ana-t-i06", "locale": "zh-CN", "query": "高流量面罩吸氧", "expect": "oxygen-high-flow" },
    { "id": "ana-t-i07", "locale": "zh-CN", "query": "快速补液500毫升生理盐水", "expect": "fluid-bolus" },
    { "id": "ana-t-i08", "locale": "zh-CN", "query": "开两支肾上腺素笔并教她怎么用", "expect": "prescribe-aai" },
    { "id": "ana-t-n03", "locale": "en", "query": "don't sit her up — lie her flat and raise her legs", "expect": "position-supine-legs", "tags": ["negation"] },
    { "id": "ana-t-n04", "locale": "zh-CN", "query": "先别让她出院", "expect": null, "tags": ["negation"] },
    { "id": "ana-t-n05", "locale": "en", "query": "do not let her walk to the emergency department", "expect": null, "tags": ["negation"] }
  ],
  "verifier": [
    { "id": "ana-t-v01", "locale": "en", "question": "How much do you weigh?", "used": ["weight"], "reply": "About 62 kilos, I think.", "expect": "pass" },
    { "id": "ana-t-v02", "locale": "en", "question": "How much do you weigh?", "used": ["weight"], "reply": "About 58 kilos.", "expect": "block", "kind": "number" },
    { "id": "ana-t-v03", "locale": "en", "question": "Do you take any medicines?", "used": ["meds"], "reply": "Just the pill, one a day. I take cetirizine in the spring for hay fever, but not at the moment.", "expect": "pass" },
    { "id": "ana-t-v04", "locale": "en", "question": "Do you take any medicines?", "used": ["meds"], "reply": "Just the pill, and a salbutamol inhaler most days.", "expect": "block", "kind": "drug" },
    { "id": "ana-t-v05", "locale": "en", "question": "Have you been stung before?", "used": ["prev-reaction"], "reply": "Once, last summer, on my ankle. My whole lower leg swelled up for days, but I could breathe fine.", "expect": "pass" },
    { "id": "ana-t-v06", "locale": "en", "question": "Have you been stung before?", "used": ["prev-reaction"], "reply": "Last summer on my ankle — that time my throat swelled up too and I had to go to hospital.", "expect": "block", "kind": "claim" },
    { "id": "ana-t-v07", "locale": "en", "question": "Any heart problems?", "used": [], "reply": "No, my heart's completely normal.", "expect": "block", "kind": "denial" },
    { "id": "ana-t-v08", "locale": "zh-CN", "question": "做过手术吗？", "used": ["psh"], "reply": "十二岁的时候割过阑尾。", "expect": "pass" },
    { "id": "ana-t-v09", "locale": "zh-CN", "question": "做过手术吗？", "used": ["psh"], "reply": "十二岁割过阑尾，前年还做过一次胆囊手术。", "expect": "block", "kind": "claim" },
    { "id": "ana-t-v10", "locale": "zh-CN", "question": "有没有可能怀孕？", "used": ["obstetric-lmp"], "reply": "不会，我在吃避孕药，上次月经是两周前。", "expect": "pass" },
    { "id": "ana-t-v11", "locale": "zh-CN", "question": "有没有可能怀孕？", "used": ["obstetric-lmp"], "reply": "不会，月经是三天前才来的。", "expect": "block", "kind": "number" },
    { "id": "ana-t-v12", "locale": "zh-CN", "question": "抽烟喝酒吗？", "used": ["social-habits"], "reply": "不抽烟，周末偶尔喝一杯红酒，今天没喝。", "expect": "pass" },
    { "id": "ana-t-n07", "locale": "en", "question": "Did you lose consciousness?", "used": ["hpi-loc"], "reply": "Yes… I blacked out for a moment…", "expect": "block", "kind": "negation", "tags": ["negation"] },
    { "id": "ana-t-n08", "locale": "zh-CN", "question": "你身上带着肾上腺素笔吗？", "used": ["aai-own"], "reply": "带着……在包里……", "expect": "block", "kind": "negation", "tags": ["negation"] },
    { "id": "ana-t-n09", "locale": "en", "question": "Do you take any heart or blood pressure tablets?", "used": ["meds-bb"], "reply": "No… never taken any…", "expect": "pass", "tags": ["negation"] },
    { "id": "ana-t-n10", "locale": "zh-CN", "question": "以前做过过敏原检测吗？", "used": ["prior-testing"], "reply": "没有……从来没做过……", "expect": "pass", "tags": ["negation"] }
  ]
}
