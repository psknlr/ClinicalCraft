{
  "$schema": "../../../schemas/grounding-set.schema.json",
  "format": "clinicalcraft/grounding-set@1",
  "suite": "grounding-v1",
  "split": "test",
  "caseId": "septic-shock-cap",
  "history": [
    { "id": "sep-t-h01", "locale": "en", "text": "How long has she been feverish?", "expect": ["hx-fever"] },
    { "id": "sep-t-h02", "locale": "en", "text": "Has she been shivering uncontrollably?", "expect": ["hx-rigors"] },
    { "id": "sep-t-h03", "locale": "en", "text": "Where does her chest hurt?", "expect": ["hx-chest-pain"], "alsoOk": ["hx-pain-modifiers"] },
    { "id": "sep-t-h04", "locale": "en", "text": "What colour is her phlegm?", "expect": ["hx-cough"] },
    { "id": "sep-t-h05", "locale": "en", "text": "Has she coughed up blood?", "expect": ["hx-haemoptysis"], "alsoOk": ["hx-cough"] },
    { "id": "sep-t-h06", "locale": "en", "text": "When did she start getting muddled?", "expect": ["hx-confusion"], "alsoOk": ["hx-orientation"] },
    { "id": "sep-t-h07", "locale": "en", "text": "How much has she been drinking, and is she passing water?", "expect": ["hx-intake-urine"] },
    { "id": "sep-t-h08", "locale": "en", "text": "Has she had any burning when she passes urine?", "expect": ["hx-urinary"] },
    { "id": "sep-t-h09", "locale": "en", "text": "Any neck stiffness or headache?", "expect": ["hx-headache-neck"] },
    { "id": "sep-t-h10", "locale": "en", "text": "Has she got any weakness down one side?", "expect": ["hx-neuro-sx"] },
    { "id": "sep-t-h11", "locale": "en", "text": "Has she taken anything for the fever?", "expect": ["hx-otc-ibuprofen"], "alsoOk": ["hx-fever", "hx-meds"] },
    { "id": "sep-t-h12", "locale": "en", "text": "Has she had antibiotics recently?", "expect": ["hx-recent-healthcare"], "alsoOk": ["hx-otc-ibuprofen"] },
    { "id": "sep-t-h13", "locale": "en", "text": "Has she had the pneumonia jab?", "expect": ["hx-vaccines"] },
    { "id": "sep-t-h14", "locale": "en", "text": "Has she ever said what she'd want if she got very ill?", "expect": ["hx-goals-care"] },
    { "id": "sep-t-h15", "locale": "en", "text": "Has she had a fall?", "expect": ["hx-falls"] },
    { "id": "sep-t-h16", "locale": "en", "text": "Does she like gardening?", "expect": [] },
    { "id": "sep-t-h17", "locale": "en", "text": "What's her favourite TV show?", "expect": [] },
    { "id": "sep-t-h18", "locale": "zh-CN", "text": "喘得厉害吗？什么时候开始的？", "expect": ["hx-dyspnoea"] },
    { "id": "sep-t-h19", "locale": "zh-CN", "text": "这几天病情是怎么变化的？", "expect": ["hx-course"] },
    { "id": "sep-t-h20", "locale": "zh-CN", "text": "有没有呕吐、拉肚子？", "expect": ["hx-gi"] },
    { "id": "sep-t-h21", "locale": "zh-CN", "text": "有没有头晕、差点晕倒？", "expect": ["hx-cvs-sx"] },
    { "id": "sep-t-h22", "locale": "zh-CN", "text": "身上酸痛吗？嗓子疼不疼？", "expect": ["hx-flu-sx"] },
    { "id": "sep-t-h23", "locale": "zh-CN", "text": "腿肿不肿？", "expect": ["hx-legs-vte"] },
    { "id": "sep-t-h24", "locale": "zh-CN", "text": "身边最近有人感冒吗？", "expect": ["hx-sick-contacts"] },
    { "id": "sep-t-h25", "locale": "zh-CN", "text": "最近接触过鸡鸭这些家禽吗？", "expect": ["hx-travel"] },
    { "id": "sep-t-h26", "locale": "zh-CN", "text": "她对青霉素过敏吗？", "expect": ["hx-allergies"] },
    { "id": "sep-t-h27", "locale": "zh-CN", "text": "她有什么慢性病？", "expect": ["hx-pmh"], "alsoOk": ["hx-lung-disease", "hx-heart-kidney"] },
    { "id": "sep-t-h28", "locale": "zh-CN", "text": "以前得过肺结核吗？", "expect": ["hx-lung-disease"], "alsoOk": ["hx-family"] },
    { "id": "sep-t-h29", "locale": "zh-CN", "text": "肾功能以前查过吗？", "expect": ["hx-heart-kidney"] },
    { "id": "sep-t-h30", "locale": "zh-CN", "text": "她平时吃哪些药？", "expect": ["hx-meds"], "alsoOk": ["hx-otc-ibuprofen"] },
    { "id": "sep-t-h31", "locale": "zh-CN", "text": "以前动过手术没有？", "expect": ["hx-psh"] },
    { "id": "sep-t-h32", "locale": "zh-CN", "text": "平时沾酒吗？", "expect": ["hx-alcohol"] },
    { "id": "sep-t-h33", "locale": "zh-CN", "text": "她跟谁一起住？", "expect": ["hx-social"] },
    { "id": "sep-t-h34", "locale": "zh-CN", "text": "生病前能自己买菜做饭吗？", "expect": ["hx-function"] },
    { "id": "sep-t-h35", "locale": "zh-CN", "text": "吃饭喝水的时候会呛吗？", "expect": ["hx-swallow"] },
    { "id": "sep-t-h36", "locale": "zh-CN", "text": "她多重？", "expect": ["hx-weight"] },
    { "id": "sep-t-h37", "locale": "zh-CN", "text": "以前拍过胸片吗？", "expect": ["hx-prior-imaging"] },
    { "id": "sep-t-h38", "locale": "zh-CN", "text": "阿姨，您知道这是哪儿吗？", "expect": ["hx-orientation"] },
    { "id": "sep-t-h39", "locale": "zh-CN", "text": "她喜欢听戏吗？", "expect": [] },
    { "id": "sep-t-h40", "locale": "zh-CN", "text": "她会打麻将吗？", "expect": [] },
    { "id": "sep-t-n01", "locale": "en", "text": "She hasn't fallen or hit her head?", "expect": ["hx-falls"], "tags": ["negation"] },
    { "id": "sep-t-n02", "locale": "zh-CN", "text": "没有吐也没有拉肚子吧？", "expect": ["hx-gi"], "tags": ["negation"] }
  ],
  "exam": [
    { "id": "sep-t-e01", "locale": "en", "query": "percuss her chest", "expect": "ex-resp-percuss" },
    { "id": "sep-t-e02", "locale": "en", "query": "is she mottled? feel her peripheries", "expect": "ex-perfusion" },
    { "id": "sep-t-e03", "locale": "en", "itemId": "4at", "expect": "ex-delirium" },
    { "id": "sep-t-e04", "locale": "en", "query": "Kernig's and Brudzinski's signs", "expect": "ex-meningism" },
    { "id": "sep-t-e05", "locale": "en", "query": "listen to her lungs again after the fluid boluses", "phase": "reassess", "expect": "ex-reassess-lungs" },
    { "id": "sep-t-e06", "locale": "zh-CN", "query": "两肺听一下", "expect": "ex-resp-ausc" },
    { "id": "sep-t-e07", "locale": "zh-CN", "query": "看看颈静脉充盈情况", "expect": "ex-jvp" },
    { "id": "sep-t-e08", "locale": "zh-CN", "query": "查一下皮肤有没有瘀点和压疮", "expect": "ex-skin" }
  ],
  "orders": [
    { "id": "sep-t-o01", "locale": "en", "query": "VBG", "expect": "vbg-lactate" },
    { "id": "sep-t-o02", "locale": "en", "itemId": "pct", "expect": "crp-pct" },
    { "id": "sep-t-o03", "locale": "en", "query": "cultures from two sites", "expect": "blood-cultures" },
    { "id": "sep-t-o04", "locale": "en", "query": "legionella and pneumococcal urine antigens", "expect": "urine-antigens" },
    { "id": "sep-t-o05", "locale": "en", "query": "CT head", "expect": null },
    { "id": "sep-t-o06", "locale": "zh-CN", "query": "查流感和新冠核酸", "expect": "resp-pcr" },
    { "id": "sep-t-o07", "locale": "zh-CN", "query": "留痰做培养", "expect": "sputum" },
    { "id": "sep-t-o08", "locale": "zh-CN", "query": "床旁超声看看心脏和下腔静脉", "expect": "pocus" },
    { "id": "sep-t-n06", "locale": "en", "query": "chest CT without contrast", "expect": "ct-chest", "tags": ["negation"] }
  ],
  "interventions": [
    { "id": "sep-t-i01", "locale": "en", "query": "500 ml Hartmann's stat", "expect": "fluid-bolus" },
    { "id": "sep-t-i02", "locale": "en", "query": "Rocephin 2 g", "expect": "abx-ceftriaxone" },
    { "id": "sep-t-i03", "locale": "en", "itemId": "noradrenaline", "expect": "norepinephrine" },
    { "id": "sep-t-i04", "locale": "en", "query": "stop her metformin and ibuprofen", "expect": "hold-home-meds" },
    { "id": "sep-t-i05", "locale": "en", "query": "start IV aciclovir", "expect": null },
    { "id": "sep-t-i06", "locale": "zh-CN", "query": "加阿奇霉素", "expect": "abx-azithromycin" },
    { "id": "sep-t-i07", "locale": "zh-CN", "query": "插尿管记每小时尿量", "expect": "urinary-catheter" },
    { "id": "sep-t-i08", "locale": "zh-CN", "query": "联系ICU", "expect": "icu-referral" },
    { "id": "sep-t-n03", "locale": "en", "query": "do not delay antibiotics for the CT", "expect": null, "tags": ["negation"] },
    { "id": "sep-t-n04", "locale": "en", "query": "stop her metformin and amlodipine", "expect": "hold-home-meds", "tags": ["negation"] },
    { "id": "sep-t-n05", "locale": "zh-CN", "query": "不要用多巴胺", "expect": null, "tags": ["negation"] }
  ],
  "verifier": [
    { "id": "sep-t-v01", "locale": "en", "question": "How high has her temperature been?", "used": ["hx-fever"], "reply": "(Daughter) Over 39 on our thermometer at home. The fever tablets bring it down for a few hours, then it's back.", "expect": "pass" },
    { "id": "sep-t-v02", "locale": "en", "question": "How high has her temperature been?", "used": ["hx-fever"], "reply": "(Daughter) It got up to 41 last night.", "expect": "block", "kind": "number" },
    { "id": "sep-t-v03", "locale": "en", "question": "What does she take regularly?", "used": ["hx-meds"], "reply": "(Daughter) Amlodipine 5 mg in the morning and metformin 500 mg twice a day.", "expect": "pass" },
    { "id": "sep-t-v04", "locale": "en", "question": "What does she take regularly?", "used": ["hx-meds"], "reply": "(Daughter) Amlodipine, metformin, and an aspirin every day.", "expect": "block", "kind": "claim", "note": "the source says no aspirin" },
    { "id": "sep-t-v05", "locale": "en", "question": "Any problems with her kidneys?", "used": ["hx-heart-kidney"], "reply": "(Daughter) A check-up about eight months ago said her kidneys were normal. I don't remember the numbers.", "expect": "pass" },
    { "id": "sep-t-v06", "locale": "en", "question": "Has she had any operations?", "used": ["hx-psh"], "reply": "(Daughter) Keyhole gallbladder surgery in 2015.", "expect": "block", "kind": "number" },
    { "id": "sep-t-v07", "locale": "en", "question": "Is she allergic to anything?", "used": [], "reply": "(Daughter) No, she's not allergic to anything.", "expect": "block", "kind": "denial", "note": "true in the case, but the voice was not given the fact" },
    { "id": "sep-t-v08", "locale": "zh-CN", "question": "她多重？", "used": ["hx-weight"], "reply": "（女儿）60公斤左右，一米五八。", "expect": "pass" },
    { "id": "sep-t-v09", "locale": "zh-CN", "question": "她自己吃过什么药？", "used": ["hx-otc-ibuprofen"], "reply": "（女儿）吃的是布洛芬缓释胶囊，一共五次左右，最后一次是今天下午五点。", "expect": "pass" },
    { "id": "sep-t-v10", "locale": "zh-CN", "question": "她自己吃过什么药？", "used": ["hx-otc-ibuprofen"], "reply": "（女儿）吃了布洛芬，还吃了两天阿莫西林。", "expect": "block", "kind": "drug" },
    { "id": "sep-t-v11", "locale": "zh-CN", "question": "她抽烟吗？", "used": ["hx-smoking"], "reply": "（病人）不抽，从来不抽。（女儿）我爸以前抽，十几年前戒了。", "expect": "pass" },
    { "id": "sep-t-v12", "locale": "zh-CN", "question": "以前得过肺病吗？", "used": [], "reply": "（女儿）没有，她肺一直很好，没得过肺炎。", "expect": "block", "kind": "denial" },
    { "id": "sep-t-n07", "locale": "en", "question": "Has she taken anything for the fever?", "used": ["hx-otc-ibuprofen"], "reply": "(Daughter) No, she hasn't taken any medicine at all.", "expect": "block", "kind": "negation", "tags": ["negation"] },
    { "id": "sep-t-n08", "locale": "zh-CN", "question": "有没有发抖、寒战？", "used": ["hx-rigors"], "reply": "（女儿）没有，她一直没发抖。", "expect": "block", "kind": "negation", "tags": ["negation"] },
    { "id": "sep-t-n09", "locale": "en", "question": "Any lung problems before?", "used": ["hx-lung-disease"], "reply": "(Daughter) No, her lungs have always been fine — never pneumonia.", "expect": "pass", "tags": ["negation"] },
    { "id": "sep-t-n10", "locale": "zh-CN", "question": "她喝酒吗？", "used": ["hx-alcohol"], "reply": "（女儿）不喝，她滴酒不沾。", "expect": "pass", "tags": ["negation"] }
  ]
}
