{
  "$schema": "../../../schemas/grounding-set.schema.json",
  "format": "clinicalcraft/grounding-set@1",
  "suite": "grounding-v1",
  "split": "test",
  "caseId": "stemi-inferior-rv",
  "history": [
    { "id": "stm-t-h01", "locale": "en", "text": "Point to where the pain is.", "expect": ["pain-site"] },
    { "id": "stm-t-h02", "locale": "en", "text": "Were you exerting yourself when it started?", "expect": ["hpi-onset"] },
    { "id": "stm-t-h03", "locale": "en", "text": "What kind of pain is it — pressing, burning, stabbing?", "expect": ["pain-character"] },
    { "id": "stm-t-h04", "locale": "en", "text": "Does the pain spread to your neck or shoulder?", "expect": ["pain-radiation"] },
    { "id": "stm-t-h05", "locale": "en", "text": "Score it out of ten for me.", "expect": ["pain-severity"] },
    { "id": "stm-t-h06", "locale": "en", "text": "Has it let up at all?", "expect": ["pain-course"] },
    { "id": "stm-t-h07", "locale": "en", "text": "Does it change when you breathe in or move?", "expect": ["pain-pleuritic"] },
    { "id": "stm-t-h08", "locale": "en", "text": "Are you nauseous?", "expect": ["assoc-nausea"] },
    { "id": "stm-t-h09", "locale": "en", "text": "Did you nearly pass out?", "expect": ["assoc-presyncope"] },
    { "id": "stm-t-h10", "locale": "en", "text": "Is it a ripping sort of pain?", "expect": ["dissection-screen"] },
    { "id": "stm-t-h11", "locale": "en", "text": "Have you taken any Viagra recently?", "expect": ["pde5"] },
    { "id": "stm-t-h12", "locale": "en", "text": "Any previous heart trouble — stents, bypass, heart failure?", "expect": ["pmh-cardiac"] },
    { "id": "stm-t-h13", "locale": "en", "text": "Have you ever vomited blood or passed black stools?", "expect": ["bleeding-history"] },
    { "id": "stm-t-h14", "locale": "en", "text": "Have you had anything to eat this morning?", "expect": ["last-meal"] },
    { "id": "stm-t-h15", "locale": "en", "text": "Do you know your cholesterol level?", "expect": ["cholesterol-values"], "alsoOk": ["pmh-lipids"] },
    { "id": "stm-t-h16", "locale": "en", "text": "Do you have a cat?", "expect": [] },
    { "id": "stm-t-h17", "locale": "en", "text": "Do you play cards?", "expect": [] },
    { "id": "stm-t-h18", "locale": "zh-CN", "text": "身上是不是一直在冒冷汗？", "expect": ["assoc-sweating"] },
    { "id": "stm-t-h19", "locale": "zh-CN", "text": "喘气费劲吗？", "expect": ["assoc-dyspnoea"] },
    { "id": "stm-t-h20", "locale": "zh-CN", "text": "平时有胃病吗？", "expect": ["gi-screen"] },
    { "id": "stm-t-h21", "locale": "zh-CN", "text": "心跳乱不乱？", "expect": ["palpitations"] },
    { "id": "stm-t-h22", "locale": "zh-CN", "text": "最近爬楼梯胸口闷过吗？", "expect": ["prodrome"] },
    { "id": "stm-t-h23", "locale": "zh-CN", "text": "腿有没有肿？", "expect": ["pe-screen"] },
    { "id": "stm-t-h24", "locale": "zh-CN", "text": "最近感冒发烧了吗？", "expect": ["infection-screen"] },
    { "id": "stm-t-h25", "locale": "zh-CN", "text": "有没有药物过敏史？", "expect": ["allergies"] },
    { "id": "stm-t-h26", "locale": "zh-CN", "text": "每天都吃哪些药？", "expect": ["medications"] },
    { "id": "stm-t-h27", "locale": "zh-CN", "text": "你在哪里上班？", "expect": ["social-living"] },
    { "id": "stm-t-h28", "locale": "zh-CN", "text": "你父母兄弟有没有心血管病？", "expect": ["family"], "alsoOk": ["brother-details"] },
    { "id": "stm-t-h29", "locale": "zh-CN", "text": "以前量过血压吗？高不高？", "expect": ["pmh-htn"] },
    { "id": "stm-t-h30", "locale": "zh-CN", "text": "查过血糖吗？", "expect": ["pmh-diabetes"] },
    { "id": "stm-t-h31", "locale": "zh-CN", "text": "有没有一侧手脚没劲？", "expect": ["neuro-symptoms"], "alsoOk": ["pain-radiation"] },
    { "id": "stm-t-h32", "locale": "zh-CN", "text": "一天抽多少烟？", "expect": ["smoking"] },
    { "id": "stm-t-h33", "locale": "zh-CN", "text": "一个星期喝几次酒？", "expect": ["alcohol"] },
    { "id": "stm-t-h34", "locale": "zh-CN", "text": "平时运动吗？", "expect": ["diet-exercise"] },
    { "id": "stm-t-h35", "locale": "zh-CN", "text": "以前做过心电图吗？", "expect": ["prior-ecg"] },
    { "id": "stm-t-h36", "locale": "zh-CN", "text": "你多重？", "expect": ["weight"] },
    { "id": "stm-t-h37", "locale": "zh-CN", "text": "你心里最放不下的是什么？", "expect": ["ice-concerns"] },
    { "id": "stm-t-h38", "locale": "zh-CN", "text": "你喜欢喝茶吗？", "expect": [] },
    { "id": "stm-t-h39", "locale": "zh-CN", "text": "你住几楼？", "expect": [] },
    { "id": "stm-t-n01", "locale": "en", "text": "You haven't taken any Viagra or similar recently?", "expect": ["pde5"], "alsoOk": ["medications"], "tags": ["negation"] },
    { "id": "stm-t-n02", "locale": "zh-CN", "text": "以前没有胃出血吧？", "expect": ["bleeding-history"], "tags": ["negation"] }
  ],
  "exam": [
    { "id": "stm-t-e01", "locale": "en", "query": "compare the BP in both arms", "expect": "bilateral-bp" },
    { "id": "stm-t-e02", "locale": "en", "query": "look at his JVP", "expect": "jvp" },
    { "id": "stm-t-e03", "locale": "en", "itemId": "auscultate-heart", "expect": "heart" },
    { "id": "stm-t-e04", "locale": "en", "query": "check the right radial and ulnar pulses before the cath lab", "expect": "access-site" },
    { "id": "stm-t-e05", "locale": "zh-CN", "query": "摸一下手脚凉不凉", "expect": "perfusion" },
    { "id": "stm-t-e06", "locale": "zh-CN", "query": "听听双肺有没有湿啰音", "expect": "lungs" },
    { "id": "stm-t-e07", "locale": "zh-CN", "query": "按压一下胸壁看疼不疼", "expect": "chest-wall" },
    { "id": "stm-t-e08", "locale": "zh-CN", "query": "看看皮肤有没有出血点", "expect": "skin-bleeding" }
  ],
  "orders": [
    { "id": "stm-t-o01", "locale": "en", "query": "right-sided ECG with V4R", "expect": "ecg-right-sided" },
    { "id": "stm-t-o02", "locale": "en", "itemId": "troponin", "expect": "hs-troponin" },
    { "id": "stm-t-o03", "locale": "en", "query": "focused cardiac ultrasound", "expect": "pocus-echo" },
    { "id": "stm-t-o04", "locale": "en", "query": "CT aortogram to rule out dissection", "expect": "ct-aortogram" },
    { "id": "stm-t-o05", "locale": "en", "query": "exercise stress test", "expect": null },
    { "id": "stm-t-o06", "locale": "zh-CN", "query": "急查凝血", "expect": "coagulation" },
    { "id": "stm-t-o07", "locale": "zh-CN", "query": "查个血脂和糖化", "expect": "lipids-hba1c" },
    { "id": "stm-t-o08", "locale": "zh-CN", "query": "急诊冠脉造影", "expect": "coronary-angiography" },
    { "id": "stm-t-n06", "locale": "en", "query": "CT aortogram to exclude aortic dissection", "expect": "ct-aortogram", "tags": ["negation"] }
  ],
  "interventions": [
    { "id": "stm-t-i01", "locale": "en", "query": "aspirin 300 mg chewed", "expect": "aspirin" },
    { "id": "stm-t-i02", "locale": "en", "query": "ticagrelor 180 mg loading dose", "expect": "ticagrelor" },
    { "id": "stm-t-i03", "locale": "en", "itemId": "cath-lab-activation", "expect": "activate-cath-lab" },
    { "id": "stm-t-i04", "locale": "en", "query": "put the defib pads on", "expect": "defib-pads" },
    { "id": "stm-t-i05", "locale": "en", "query": "give IV adenosine 6 mg", "expect": null },
    { "id": "stm-t-i06", "locale": "zh-CN", "query": "补液250毫升生理盐水", "expect": "fluid-bolus" },
    { "id": "stm-t-i07", "locale": "zh-CN", "query": "静推普通肝素", "expect": "ufh" },
    { "id": "stm-t-i08", "locale": "zh-CN", "query": "持续心电血压血氧监测", "expect": "cardiac-monitoring" },
    { "id": "stm-t-n03", "locale": "en", "query": "no nitrates — this is a right ventricular infarct", "expect": null, "tags": ["negation"] },
    { "id": "stm-t-n04", "locale": "zh-CN", "query": "暂停美托洛尔", "expect": null, "tags": ["negation"] },
    { "id": "stm-t-n05", "locale": "en", "query": "hold the morphine", "expect": null, "tags": ["negation"] }
  ],
  "verifier": [
    { "id": "stm-t-v01", "locale": "en", "question": "When did the pain start?", "used": ["hpi-onset"], "reply": "Around eight this morning, carrying a box of files up the stairs at work.", "expect": "pass" },
    { "id": "stm-t-v02", "locale": "en", "question": "When did the pain start?", "used": ["hpi-onset"], "reply": "Around six this morning, when I woke up.", "expect": "block", "kind": "claim" },
    { "id": "stm-t-v03", "locale": "en", "question": "What medicines do you take?", "used": ["medications"], "reply": "Just amlodipine 5 mg — I took it at seven this morning. I stopped my statin a long time ago.", "expect": "pass" },
    { "id": "stm-t-v04", "locale": "en", "question": "What medicines do you take?", "used": ["medications"], "reply": "Amlodipine 5 mg, and an aspirin every morning.", "expect": "block", "kind": "claim", "note": "the source says no aspirin" },
    { "id": "stm-t-v05", "locale": "en", "question": "Do you smoke?", "used": ["smoking"], "reply": "A pack a day since I was twenty — thirty-eight years now.", "expect": "pass" },
    { "id": "stm-t-v06", "locale": "en", "question": "Any heart trouble in the family?", "used": ["family"], "reply": "My father died suddenly at 62, and my younger brother had a stent when he was 52.", "expect": "pass", "note": "faithful: the source spells the ages out" },
    { "id": "stm-t-v07", "locale": "en", "question": "Do you have diabetes?", "used": [], "reply": "No, my sugar has always been normal.", "expect": "block", "kind": "denial" },
    { "id": "stm-t-v08", "locale": "zh-CN", "question": "你多重？", "used": ["weight"], "reply": "七十八公斤左右，个子一米七二。", "expect": "pass" },
    { "id": "stm-t-v09", "locale": "zh-CN", "question": "你多重？", "used": ["weight"], "reply": "八十五公斤，一米七五。", "expect": "block", "kind": "number" },
    { "id": "stm-t-v10", "locale": "zh-CN", "question": "血脂高吗？", "used": ["pmh-lipids"], "reply": "两年前体检说血脂高，开了阿托伐他汀，吃了三个月就停了。", "expect": "pass" },
    { "id": "stm-t-v11", "locale": "zh-CN", "question": "血脂高吗？", "used": ["pmh-lipids"], "reply": "两年前体检说血脂高，一直在吃瑞舒伐他汀。", "expect": "block", "kind": "drug" },
    { "id": "stm-t-v12", "locale": "zh-CN", "question": "做过手术吗？", "used": ["psh"], "reply": "二十多岁时切过阑尾。去年还做过胃镜，说有胃溃疡。", "expect": "block", "kind": "claim" },
    { "id": "stm-t-n07", "locale": "en", "question": "Any Viagra or similar in the last two days?", "used": ["pde5"], "reply": "Yes, I took one last night.", "expect": "block", "kind": "negation", "tags": ["negation"] },
    { "id": "stm-t-n08", "locale": "zh-CN", "question": "以前有过出血吗？", "used": ["bleeding-history"], "reply": "去年胃出血住过一次院。", "expect": "block", "kind": "negation", "tags": ["negation"] },
    { "id": "stm-t-n09", "locale": "en", "question": "Any palpitations?", "used": ["palpitations"], "reply": "No, my heart hasn't been racing or jumping about.", "expect": "pass", "tags": ["negation"] },
    { "id": "stm-t-n10", "locale": "zh-CN", "question": "有糖尿病吗？", "used": ["pmh-diabetes"], "reply": "没有，没人说过我血糖高。", "expect": "pass", "tags": ["negation"] }
  ]
}
