{
  "$schema": "../../../schemas/grounding-set.schema.json",
  "format": "clinicalcraft/grounding-set@1",
  "suite": "grounding-v1",
  "split": "test",
  "caseId": "pediatric-asthma",
  "history": [
    { "id": "pas-t-h01", "locale": "en", "text": "When did the wheezing start?", "expect": ["hx-onset"] },
    { "id": "pas-t-h02", "locale": "en", "text": "Has he been snotty or had a cold this week?", "expect": ["hx-viral-prodrome"] },
    { "id": "pas-t-h03", "locale": "en", "text": "How many puffs of Ventolin has he had since last night?", "expect": ["hx-reliever-use-today"] },
    { "id": "pas-t-h04", "locale": "en", "text": "Has he been drinking, and has he passed urine today?", "expect": ["hx-feeding"] },
    { "id": "pas-t-h05", "locale": "en", "text": "Is he coughing anything up?", "expect": ["hx-cough"] },
    { "id": "pas-t-h06", "locale": "en", "text": "Has he had a temperature?", "expect": ["hx-fever"] },
    { "id": "pas-t-h07", "locale": "en", "text": "Could he have breathed in a small toy or something?", "expect": ["hx-foreign-body"] },
    { "id": "pas-t-h08", "locale": "en", "text": "Has he ever been in intensive care with his asthma?", "expect": ["hx-picu-intubation"], "alsoOk": ["hx-prior-admissions"] },
    { "id": "pas-t-h09", "locale": "en", "text": "Is he using his preventer inhaler every day?", "expect": ["hx-adherence"], "alsoOk": ["hx-controller"] },
    { "id": "pas-t-h10", "locale": "en", "text": "Do you use a spacer with his inhaler?", "expect": ["hx-technique"], "alsoOk": ["hx-reliever-use-today"] },
    { "id": "pas-t-h11", "locale": "en", "text": "Is he exposed to cigarette smoke?", "expect": ["hx-smoke"] },
    { "id": "pas-t-h12", "locale": "en", "text": "Was he born early?", "expect": ["hx-birth"] },
    { "id": "pas-t-h13", "locale": "en", "text": "Has he had his flu vaccine?", "expect": ["hx-immunisation"] },
    { "id": "pas-t-h14", "locale": "en", "text": "Do you have a written asthma plan?", "expect": ["hx-action-plan"] },
    { "id": "pas-t-h15", "locale": "en", "text": "Is there any mould at home?", "expect": ["hx-unknown-mould"] },
    { "id": "pas-t-h16", "locale": "en", "text": "Are you feeling better now, mate?", "phase": "reassess", "expect": ["hx-child-feeling-later"] },
    { "id": "pas-t-h17", "locale": "en", "text": "Does he have a bike?", "expect": [] },
    { "id": "pas-t-h18", "locale": "en", "text": "What's his teacher's name?", "expect": [] },
    { "id": "pas-t-h19", "locale": "zh-CN", "text": "孩子以前住过院吗？", "expect": ["hx-prior-admissions"], "alsoOk": ["hx-picu-intubation"] },
    { "id": "pas-t-h20", "locale": "zh-CN", "text": "这一年吃过几次激素？", "expect": ["hx-oral-steroid-courses"] },
    { "id": "pas-t-h21", "locale": "zh-CN", "text": "平时每天用的预防药是什么？", "expect": ["hx-controller"], "alsoOk": ["hx-adherence"] },
    { "id": "pas-t-h22", "locale": "zh-CN", "text": "家里有雾化机吗？", "expect": ["hx-home-nebuliser"] },
    { "id": "pas-t-h23", "locale": "zh-CN", "text": "这两天还吃了别的什么药？", "expect": ["hx-other-meds"], "alsoOk": ["hx-reliever-use-today"] },
    { "id": "pas-t-h24", "locale": "zh-CN", "text": "孩子有没有药物过敏？", "expect": ["hx-allergies"] },
    { "id": "pas-t-h25", "locale": "zh-CN", "text": "小时候有没有湿疹？", "expect": ["hx-atopy"], "alsoOk": ["hx-pmh-other"] },
    { "id": "pas-t-h26", "locale": "zh-CN", "text": "孩子长得怎么样？上学跟得上吗？", "expect": ["hx-development"] },
    { "id": "pas-t-h27", "locale": "zh-CN", "text": "爸爸妈妈有哮喘吗？", "expect": ["hx-family"] },
    { "id": "pas-t-h28", "locale": "zh-CN", "text": "家里养猫狗吗？", "expect": ["hx-home"], "alsoOk": ["hx-triggers"] },
    { "id": "pas-t-h29", "locale": "zh-CN", "text": "一般什么情况下容易犯？", "expect": ["hx-triggers"] },
    { "id": "pas-t-h30", "locale": "zh-CN", "text": "孩子有多重？", "expect": ["hx-weight"] },
    { "id": "pas-t-h31", "locale": "zh-CN", "text": "您心里最担心什么？", "expect": ["hx-ice-concerns"] },
    { "id": "pas-t-h32", "locale": "zh-CN", "text": "孩子犯不犯困？叫得醒吗？", "expect": ["hx-alertness"] },
    { "id": "pas-t-h33", "locale": "zh-CN", "text": "吸气的时候有没有怪声？", "expect": ["hx-upper-airway"] },
    { "id": "pas-t-h34", "locale": "zh-CN", "text": "做过肺功能吗？", "expect": ["hx-unknown-spirometry"] },
    { "id": "pas-t-h35", "locale": "zh-CN", "text": "孩子喜欢吃什么零食？", "expect": [] },
    { "id": "pas-t-h36", "locale": "zh-CN", "text": "他会骑自行车吗？", "expect": [] },
    { "id": "pas-t-n01", "locale": "en", "text": "He's never been in intensive care, has he?", "expect": ["hx-picu-intubation"], "alsoOk": ["hx-prior-admissions"], "tags": ["negation"] },
    { "id": "pas-t-n02", "locale": "zh-CN", "text": "他应该没误吸什么异物吧？", "expect": ["hx-foreign-body"], "tags": ["negation"] }
  ],
  "exam": [
    { "id": "pas-t-e01", "locale": "en", "query": "can he talk in full sentences?", "expect": "ex-speech" },
    { "id": "pas-t-e02", "locale": "en", "query": "look for subcostal recession and accessory muscle use", "expect": "ex-work-of-breathing" },
    { "id": "pas-t-e03", "locale": "en", "itemId": "listen-to-chest", "expect": "ex-auscultation" },
    { "id": "pas-t-e04", "locale": "en", "query": "look in his ears and throat", "expect": "ex-ent" },
    { "id": "pas-t-e05", "locale": "en", "query": "watch mum use the inhaler with the spacer", "phase": "reassess", "expect": "ex-inhaler-technique" },
    { "id": "pas-t-e06", "locale": "zh-CN", "query": "看看气管居中吗，有没有皮下气肿", "expect": "ex-chest-inspection" },
    { "id": "pas-t-e07", "locale": "zh-CN", "query": "评估一下有没有脱水", "expect": "ex-hydration" },
    { "id": "pas-t-e08", "locale": "zh-CN", "query": "AVPU评分", "expect": "ex-mental-status" }
  ],
  "orders": [
    { "id": "pas-t-o01", "locale": "en", "query": "PRAM score", "expect": "pram" },
    { "id": "pas-t-o02", "locale": "en", "itemId": "peak-flow", "expect": "pef" },
    { "id": "pas-t-o03", "locale": "en", "query": "check his sats off oxygen", "expect": "spo2-ra" },
    { "id": "pas-t-o04", "locale": "en", "query": "nasopharyngeal swab for viruses", "expect": "viral-pcr" },
    { "id": "pas-t-o05", "locale": "en", "query": "sweat chloride test", "expect": null },
    { "id": "pas-t-o06", "locale": "zh-CN", "query": "拍个胸片看看", "expect": "cxr" },
    { "id": "pas-t-o07", "locale": "zh-CN", "query": "查血气", "expect": "vbg" },
    { "id": "pas-t-o08", "locale": "zh-CN", "query": "调一下以前的病历和处方", "expect": "ehr-records" },
    { "id": "pas-t-n06", "locale": "en", "query": "chest X-ray to exclude a pneumothorax", "expect": "cxr", "tags": ["negation"] }
  ],
  "interventions": [
    { "id": "pas-t-i01", "locale": "en", "query": "salbutamol 10 puffs via spacer", "expect": "salbutamol-mdi" },
    { "id": "pas-t-i02", "locale": "en", "query": "add ipratropium nebs", "expect": "ipratropium-neb" },
    { "id": "pas-t-i03", "locale": "en", "query": "prednisolone 40 mg orally", "expect": "prednisolone" },
    { "id": "pas-t-i04", "locale": "en", "itemId": "mgso4-iv", "expect": "magnesium-iv" },
    { "id": "pas-t-i05", "locale": "en", "query": "give adrenaline 0.15 mg IM", "expect": null },
    { "id": "pas-t-i06", "locale": "zh-CN", "query": "面罩吸氧，维持血氧94%以上", "expect": "oxygen" },
    { "id": "pas-t-i07", "locale": "zh-CN", "query": "让孩子坐在妈妈腿上，保持安静", "expect": "position-upright" },
    { "id": "pas-t-i08", "locale": "zh-CN", "query": "给他写一份哮喘行动计划", "expect": "action-plan" },
    { "id": "pas-t-n03", "locale": "en", "query": "do not sedate him", "expect": null, "tags": ["negation"] },
    { "id": "pas-t-n04", "locale": "zh-CN", "query": "不需要用抗生素", "expect": null, "tags": ["negation"] },
    { "id": "pas-t-n05", "locale": "en", "query": "no IV magnesium for now", "expect": null, "tags": ["negation"] }
  ],
  "verifier": [
    { "id": "pas-t-v01", "locale": "en", "question": "How much Ventolin has he had?", "used": ["hx-reliever-use-today"], "reply": "Two puffs at 1, two at 3 and two more at 5. Each time it helped for about half an hour.", "expect": "pass" },
    { "id": "pas-t-v02", "locale": "en", "question": "How much Ventolin has he had?", "used": ["hx-reliever-use-today"], "reply": "About ten puffs since midnight, and it didn't help at all.", "expect": "block", "kind": "number" },
    { "id": "pas-t-v03", "locale": "en", "question": "Has he had a fever?", "used": ["hx-fever"], "reply": "He felt warm yesterday evening — 37.8 under his arm. I didn't give him anything for it.", "expect": "pass" },
    { "id": "pas-t-v04", "locale": "en", "question": "Has he had a fever?", "used": ["hx-fever"], "reply": "Yes, it went up to 39.5 last night.", "expect": "block", "kind": "number" },
    { "id": "pas-t-v05", "locale": "en", "question": "Has he been in hospital with his asthma?", "used": ["hx-prior-admissions"], "reply": "Twice to emergency this past year after colds, and he was admitted once at 4 — three days on oxygen.", "expect": "pass" },
    { "id": "pas-t-v06", "locale": "en", "question": "Does he have any allergies?", "used": [], "reply": "No, he's not allergic to anything.", "expect": "block", "kind": "denial" },
    { "id": "pas-t-v07", "locale": "en", "question": "What's his preventer?", "used": ["hx-controller"], "reply": "Flixotide — one puff morning and night through the spacer.", "expect": "pass" },
    { "id": "pas-t-v08", "locale": "zh-CN", "question": "孩子多重？", "used": ["hx-weight"], "reply": "刚才分诊称的，20公斤。", "expect": "pass" },
    { "id": "pas-t-v09", "locale": "zh-CN", "question": "孩子多重？", "used": ["hx-weight"], "reply": "大概22公斤吧。", "expect": "block", "kind": "number" },
    { "id": "pas-t-v10", "locale": "zh-CN", "question": "家里有人抽烟吗？", "used": ["hx-smoke"], "reply": "他爸爸抽烟，说是只在阳台抽，可衣服上老有烟味。他奶奶也有哮喘。", "expect": "block", "kind": "claim" },
    { "id": "pas-t-v11", "locale": "zh-CN", "question": "吃过几次激素？", "used": ["hx-oral-steroid-courses"], "reply": "两次，每次吃3天的激素糖浆。", "expect": "pass" },
    { "id": "pas-t-v12", "locale": "zh-CN", "question": "以前进过ICU吗？", "used": [], "reply": "没有，从来没进过ICU。", "expect": "block", "kind": "denial", "note": "true in the case, but the voice was not given the fact" },
    { "id": "pas-t-n07", "locale": "en", "question": "Has he ever needed intensive care?", "used": ["hx-picu-intubation"], "reply": "(Mother) Yes, once — he was on a ventilator in intensive care.", "expect": "block", "kind": "negation", "tags": ["negation"] },
    { "id": "pas-t-n08", "locale": "zh-CN", "question": "他发烧了吗？", "used": ["hx-fever"], "reply": "（妈妈）没发烧，体温一直正常。", "expect": "block", "kind": "negation", "tags": ["negation"] },
    { "id": "pas-t-n09", "locale": "en", "question": "Could he have choked on something?", "used": ["hx-foreign-body"], "reply": "(Mother) No, he didn't choke on anything.", "expect": "pass", "tags": ["negation"] },
    { "id": "pas-t-n10", "locale": "zh-CN", "question": "最近去过外地吗？", "used": ["hx-travel"], "reply": "（妈妈）没有，哪儿也没去。", "expect": "pass", "tags": ["negation"] }
  ]
}
