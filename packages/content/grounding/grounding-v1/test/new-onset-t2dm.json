{
  "$schema": "../../../schemas/grounding-set.schema.json",
  "format": "clinicalcraft/grounding-set@1",
  "suite": "grounding-v1",
  "split": "test",
  "caseId": "new-onset-t2dm",
  "history": [
    { "id": "t2d-t-h01", "locale": "en", "text": "What can I do for you today?", "expect": ["hx-chief"] },
    { "id": "t2d-t-h02", "locale": "en", "text": "Are you getting up at night to pee?", "expect": ["hx-polyuria"] },
    { "id": "t2d-t-h03", "locale": "en", "text": "How much are you drinking each day?", "expect": ["hx-polydipsia"] },
    { "id": "t2d-t-h04", "locale": "en", "text": "Have you lost weight without trying?", "expect": ["hx-weightloss"] },
    { "id": "t2d-t-h05", "locale": "en", "text": "Has your vision been blurry?", "expect": ["hx-vision"] },
    { "id": "t2d-t-h06", "locale": "en", "text": "Any boils or skin infections recently?", "expect": ["hx-infections"] },
    { "id": "t2d-t-h07", "locale": "en", "text": "Any pins and needles in your feet?", "expect": ["hx-neuro-sx"] },
    { "id": "t2d-t-h08", "locale": "en", "text": "Do you get chest pain when you climb stairs?", "expect": ["hx-cardiac-sx"] },
    { "id": "t2d-t-h09", "locale": "en", "text": "Does your wife say you snore?", "expect": ["hx-osa"] },
    { "id": "t2d-t-h10", "locale": "en", "text": "Have you ever had your sugar tested before?", "expect": ["hx-prior-glucose"] },
    { "id": "t2d-t-h11", "locale": "en", "text": "Do you take anything over the counter, like painkillers?", "expect": ["hx-meds"] },
    { "id": "t2d-t-h12", "locale": "en", "text": "How many cigarettes a day?", "expect": ["hx-smoking"] },
    { "id": "t2d-t-h13", "locale": "en", "text": "What do you usually eat in a day?", "expect": ["hx-diet"] },
    { "id": "t2d-t-h14", "locale": "en", "text": "Have you had a flu jab or a hepatitis B vaccine?", "expect": ["hx-unk-vaccines"] },
    { "id": "t2d-t-h15", "locale": "en", "text": "Are you still smoking?", "phase": "review", "expect": ["hx-rv-smoking"] },
    { "id": "t2d-t-h16", "locale": "en", "text": "Do you play a musical instrument?", "expect": [] },
    { "id": "t2d-t-h17", "locale": "en", "text": "What's your favourite holiday destination?", "expect": [] },
    { "id": "t2d-t-h18", "locale": "zh-CN", "text": "有没有恶心呕吐、肚子疼？", "expect": ["hx-ketosis-sx"] },
    { "id": "t2d-t-h19", "locale": "zh-CN", "text": "龟头那里痒不痒？有没有发红？", "expect": ["hx-genital"] },
    { "id": "t2d-t-h20", "locale": "zh-CN", "text": "性生活方面有没有问题？", "expect": ["hx-erectile"] },
    { "id": "t2d-t-h21", "locale": "zh-CN", "text": "有没有怕热、出汗多？", "expect": ["hx-thyroid-sx"] },
    { "id": "t2d-t-h22", "locale": "zh-CN", "text": "晚上出汗吗？有没有咳血？", "expect": ["hx-wl-redflags"] },
    { "id": "t2d-t-h23", "locale": "zh-CN", "text": "尿里有泡沫吗？", "expect": ["hx-urinary-other"] },
    { "id": "t2d-t-h24", "locale": "zh-CN", "text": "以前血压高过吗？", "expect": ["hx-prior-bp"] },
    { "id": "t2d-t-h25", "locale": "zh-CN", "text": "以前得过什么病？", "expect": ["hx-pmh"] },
    { "id": "t2d-t-h26", "locale": "zh-CN", "text": "喝酒多吗？", "expect": ["hx-alcohol"] },
    { "id": "t2d-t-h27", "locale": "zh-CN", "text": "平时锻炼身体吗？", "expect": ["hx-exercise"] },
    { "id": "t2d-t-h28", "locale": "zh-CN", "text": "工作需要经常开车吗？", "expect": ["hx-occupation"] },
    { "id": "t2d-t-h29", "locale": "zh-CN", "text": "你父母有糖尿病吗？", "expect": ["hx-family"] },
    { "id": "t2d-t-h30", "locale": "zh-CN", "text": "您自己觉得是怎么回事？", "expect": ["hx-ice-ideas"] },
    { "id": "t2d-t-h31", "locale": "zh-CN", "text": "心情怎么样？", "expect": ["hx-mood"] },
    { "id": "t2d-t-h32", "locale": "zh-CN", "text": "查过血脂吗？", "expect": ["hx-unk-lipids"] },
    { "id": "t2d-t-h33", "locale": "zh-CN", "text": "二甲双胍吃了以后有没有拉肚子？", "phase": "review", "expect": ["hx-rv-sideeffects"] },
    { "id": "t2d-t-h34", "locale": "zh-CN", "text": "你喜欢下棋吗？", "expect": [] },
    { "id": "t2d-t-h35", "locale": "zh-CN", "text": "你住在几楼？", "expect": [] }
  ],
  "exam": [
    { "id": "t2d-t-e01", "locale": "en", "query": "measure his waist circumference", "expect": "ex-anthro" },
    { "id": "t2d-t-e02", "locale": "en", "itemId": "acanthosis-nigricans", "expect": "ex-acanthosis" },
    { "id": "t2d-t-e03", "locale": "en", "query": "monofilament test on both feet", "expect": "ex-monofilament" },
    { "id": "t2d-t-e04", "locale": "en", "itemId": "foot-pulses", "expect": "ex-pulses" },
    { "id": "t2d-t-e05", "locale": "zh-CN", "query": "用音叉查一下振动觉", "expect": "ex-vibration" },
    { "id": "t2d-t-e06", "locale": "zh-CN", "query": "查眼底", "expect": "ex-fundoscopy" },
    { "id": "t2d-t-e07", "locale": "zh-CN", "query": "量血压", "expect": "ex-bp" },
    { "id": "t2d-t-e08", "locale": "zh-CN", "query": "查一下有没有满月脸、紫纹", "expect": "ex-cushing" }
  ],
  "orders": [
    { "id": "t2d-t-o01", "locale": "en", "query": "HbA1c", "expect": "inv-hba1c" },
    { "id": "t2d-t-o02", "locale": "en", "itemId": "urine-acr", "expect": "inv-uacr" },
    { "id": "t2d-t-o03", "locale": "en", "query": "fasting lipid panel", "expect": "inv-lipids" },
    { "id": "t2d-t-o04", "locale": "en", "itemId": "gad-antibodies", "expect": "inv-cpep-gad" },
    { "id": "t2d-t-o05", "locale": "en", "query": "MRI of the pituitary", "expect": null },
    { "id": "t2d-t-o06", "locale": "zh-CN", "query": "查空腹血糖", "expect": "inv-fpg" },
    { "id": "t2d-t-o07", "locale": "zh-CN", "query": "查个甲功", "expect": "inv-tsh" },
    { "id": "t2d-t-o08", "locale": "zh-CN", "query": "眼底照相筛查糖网", "expect": "inv-retinal" }
  ],
  "interventions": [
    { "id": "t2d-t-i01", "locale": "en", "query": "start metformin 500 mg once daily and titrate up", "expect": "iv-metformin" },
    { "id": "t2d-t-i02", "locale": "en", "query": "atorvastatin 40 mg at night", "expect": "iv-statin" },
    { "id": "t2d-t-i03", "locale": "en", "itemId": "ace-inhibitor", "expect": "iv-acei" },
    { "id": "t2d-t-i04", "locale": "en", "query": "refer to a dietitian and diabetes education", "expect": "iv-lifestyle" },
    { "id": "t2d-t-i05", "locale": "en", "query": "start pioglitazone 15 mg", "expect": null },
    { "id": "t2d-t-i06", "locale": "zh-CN", "query": "开伐尼克兰帮他戒烟", "expect": "iv-smoking" },
    { "id": "t2d-t-i07", "locale": "zh-CN", "query": "外用克霉唑乳膏", "expect": "iv-antifungal" },
    { "id": "t2d-t-i08", "locale": "zh-CN", "query": "三个月后复诊", "expect": "iv-follow-up" }
  ],
  "verifier": [
    { "id": "t2d-t-v01", "locale": "en", "question": "Has your weight changed?", "used": ["hx-weightloss"], "reply": "I've lost about three kilos — I was 92 at last year's check-up and 89 a couple of days ago.", "expect": "pass" },
    { "id": "t2d-t-v02", "locale": "en", "question": "Has your weight changed?", "used": ["hx-weightloss"], "reply": "I've lost about five kilos since last year.", "expect": "block", "kind": "number" },
    { "id": "t2d-t-v03", "locale": "en", "question": "Do you take any medicines?", "used": ["hx-meds"], "reply": "Nothing regular — just ibuprofen for my knee once or twice a month.", "expect": "pass" },
    { "id": "t2d-t-v04", "locale": "en", "question": "Do you take any medicines?", "used": ["hx-meds"], "reply": "Nothing regular, apart from some prednisolone a friend gave me for my knee.", "expect": "block", "kind": "drug" },
    { "id": "t2d-t-v05", "locale": "en", "question": "Does diabetes run in your family?", "used": ["hx-family"], "reply": "My dad has diabetes — he was on insulin for over ten years — and my older brother takes tablets for his sugar.", "expect": "pass" },
    { "id": "t2d-t-v06", "locale": "en", "question": "Have you ever had problems with your kidneys?", "used": [], "reply": "No, never — my kidneys are fine.", "expect": "block", "kind": "denial" },
    { "id": "t2d-t-v07", "locale": "en", "question": "Do you smoke?", "used": ["hx-smoking"], "reply": "Yes, about twenty a day for twenty-five years. Honestly, I'd like to stop.", "expect": "pass" },
    { "id": "t2d-t-v08", "locale": "zh-CN", "question": "以前量过血压吗？", "used": ["hx-prior-bp"], "reply": "去年体检是146/92，说偏高，后来一直没再量。", "expect": "pass" },
    { "id": "t2d-t-v09", "locale": "zh-CN", "question": "以前量过血压吗？", "used": ["hx-prior-bp"], "reply": "去年体检是160/100，医生给我开了降压药。", "expect": "block", "kind": "number" },
    { "id": "t2d-t-v10", "locale": "zh-CN", "question": "喝酒吗？", "used": ["hx-alcohol"], "reply": "应酬的时候喝，一周一两次，一次三瓶啤酒左右。我爸六十八岁中过一次风。", "expect": "block", "kind": "unasked" },
    { "id": "t2d-t-v11", "locale": "zh-CN", "question": "运动吗？", "used": ["hx-exercise"], "reply": "基本不运动，手机上一天也就三千来步。", "expect": "pass" },
    { "id": "t2d-t-v12", "locale": "zh-CN", "question": "手脚有没有发麻？", "used": [], "reply": "没有，手脚感觉都很正常，也没有脚气。", "expect": "block", "kind": "denial" }
  ]
}
