{
  "$schema": "../../../schemas/grounding-set.schema.json",
  "format": "clinicalcraft/grounding-set@1",
  "suite": "grounding-v1",
  "split": "test",
  "caseId": "pulmonary-embolism-postop",
  "history": [
    { "id": "pe-t-h01", "locale": "en", "text": "Tell me what's wrong.", "expect": ["h-cc"] },
    { "id": "pe-t-h02", "locale": "en", "text": "Did it come on suddenly?", "expect": ["h-onset"] },
    { "id": "pe-t-h03", "locale": "en", "text": "Does the pain go anywhere — your arm or your jaw?", "expect": ["h-pain-site"] },
    { "id": "pe-t-h04", "locale": "en", "text": "Does it hurt more when you take a deep breath?", "expect": ["h-pain-character"] },
    { "id": "pe-t-h05", "locale": "en", "text": "How bad is the pain, from zero to ten?", "expect": ["h-pain-severity"] },
    { "id": "pe-t-h06", "locale": "en", "text": "Did you feel faint when it started?", "expect": ["h-syncope"] },
    { "id": "pe-t-h07", "locale": "en", "text": "Is your heart racing?", "expect": ["h-palpitations"] },
    { "id": "pe-t-h08", "locale": "en", "text": "Any blood when you cough?", "expect": ["h-haemoptysis"] },
    { "id": "pe-t-h09", "locale": "en", "text": "Any pain in your calves?", "expect": ["h-calf"] },
    { "id": "pe-t-h10", "locale": "en", "text": "Did you get your heparin injection last night?", "expect": ["h-lmwh"], "alsoOk": ["h-meds"] },
    { "id": "pe-t-h11", "locale": "en", "text": "Are you wearing your TED stockings?", "expect": ["h-stockings"] },
    { "id": "pe-t-h12", "locale": "en", "text": "What surgery were you in for?", "expect": ["h-surgery"], "alsoOk": ["h-cancer"] },
    { "id": "pe-t-h13", "locale": "en", "text": "Have you ever had a DVT or a clot on the lung?", "expect": ["h-prior-vte"] },
    { "id": "pe-t-h14", "locale": "en", "text": "Are you on HRT?", "expect": ["h-hormones"] },
    { "id": "pe-t-h15", "locale": "en", "text": "Have you been on any long flights lately?", "expect": ["h-travel"] },
    { "id": "pe-t-h16", "locale": "en", "text": "Has anyone checked you for thrombophilia?", "expect": ["h-unk-thrombophilia"] },
    { "id": "pe-t-h17", "locale": "en", "text": "Do you have a garden?", "expect": [] },
    { "id": "pe-t-h18", "locale": "en", "text": "Do you like reading?", "expect": [] },
    { "id": "pe-t-h19", "locale": "zh-CN", "text": "肚子刀口疼得厉害吗？", "expect": ["h-abdo-pain"] },
    { "id": "pe-t-h20", "locale": "zh-CN", "text": "坐着不动也喘吗？", "expect": ["h-dyspnoea"] },
    { "id": "pe-t-h21", "locale": "zh-CN", "text": "有没有发烧、咳黄痰？", "expect": ["h-fever-sputum"] },
    { "id": "pe-t-h22", "locale": "zh-CN", "text": "昨天有没有走几步就气短？", "expect": ["h-prodrome"], "alsoOk": ["h-mobility"] },
    { "id": "pe-t-h23", "locale": "zh-CN", "text": "术后下床走动了吗？", "expect": ["h-mobility"] },
    { "id": "pe-t-h24", "locale": "zh-CN", "text": "肠癌是怎么发现的？", "expect": ["h-cancer"] },
    { "id": "pe-t-h25", "locale": "zh-CN", "text": "您现在都在用哪些药？", "expect": ["h-meds"], "alsoOk": ["h-lmwh"] },
    { "id": "pe-t-h26", "locale": "zh-CN", "text": "对造影剂过敏吗？", "expect": ["h-allergies"] },
    { "id": "pe-t-h27", "locale": "zh-CN", "text": "有高血压、糖尿病吗？", "expect": ["h-pmh"] },
    { "id": "pe-t-h28", "locale": "zh-CN", "text": "有没有胃溃疡或者出血的毛病？", "expect": ["h-bleeding"] },
    { "id": "pe-t-h29", "locale": "zh-CN", "text": "以前中过风吗？", "expect": ["h-neuro-history"] },
    { "id": "pe-t-h30", "locale": "zh-CN", "text": "排气了吗？", "expect": ["h-gi"] },
    { "id": "pe-t-h31", "locale": "zh-CN", "text": "拔尿管以后小便正常吗？", "expect": ["h-urine"] },
    { "id": "pe-t-h32", "locale": "zh-CN", "text": "您平时抽不抽烟？", "expect": ["h-smoking"] },
    { "id": "pe-t-h33", "locale": "zh-CN", "text": "家里人有得过血栓的吗？", "expect": ["h-family"] },
    { "id": "pe-t-h34", "locale": "zh-CN", "text": "您多重？", "expect": ["h-weight"] },
    { "id": "pe-t-h35", "locale": "zh-CN", "text": "肿瘤是几期？", "expect": ["h-unk-stage"] },
    { "id": "pe-t-h36", "locale": "zh-CN", "text": "您喜欢养花吗？", "expect": [] },
    { "id": "pe-t-h37", "locale": "zh-CN", "text": "您会做饭吗？", "expect": [] }
  ],
  "exam": [
    { "id": "pe-t-e01", "locale": "en", "query": "check her JVP", "expect": "ex-jvp" },
    { "id": "pe-t-e02", "locale": "en", "itemId": "calf-circumference", "expect": "ex-legs" },
    { "id": "pe-t-e03", "locale": "en", "query": "auscultate both lung fields", "expect": "ex-chest-ausc" },
    { "id": "pe-t-e04", "locale": "en", "query": "press on the chest wall to see if it reproduces the pain", "expect": "ex-chest-wall" },
    { "id": "pe-t-e05", "locale": "zh-CN", "query": "看看气管有没有偏", "expect": "ex-trachea" },
    { "id": "pe-t-e06", "locale": "zh-CN", "query": "看一下刀口", "expect": "ex-abdomen" },
    { "id": "pe-t-e07", "locale": "zh-CN", "query": "看看睑结膜苍白不苍白", "expect": "ex-mucosa" },
    { "id": "pe-t-e08", "locale": "zh-CN", "query": "摸摸手脚凉不凉，脉搏怎么样", "expect": "ex-perfusion" }
  ],
  "orders": [
    { "id": "pe-t-o01", "locale": "en", "query": "CTPA", "expect": "ctpa" },
    { "id": "pe-t-o02", "locale": "en", "itemId": "bnp", "expect": "ntprobnp" },
    { "id": "pe-t-o03", "locale": "en", "query": "Doppler ultrasound of both legs", "expect": "cus-legs" },
    { "id": "pe-t-o04", "locale": "en", "query": "arterial blood gases", "expect": "abg" },
    { "id": "pe-t-o05", "locale": "en", "query": "V/Q scan", "expect": null },
    { "id": "pe-t-o06", "locale": "zh-CN", "query": "查D-二聚体", "expect": "d-dimer" },
    { "id": "pe-t-o07", "locale": "zh-CN", "query": "床旁心超", "expect": "echo" },
    { "id": "pe-t-o08", "locale": "zh-CN", "query": "看一下护理记录和用药记录", "expect": "mar" }
  ],
  "interventions": [
    { "id": "pe-t-i01", "locale": "en", "query": "start a heparin infusion", "expect": "ufh" },
    { "id": "pe-t-i02", "locale": "en", "query": "high-flow oxygen via a non-rebreather", "expect": "o2-nrb" },
    { "id": "pe-t-i03", "locale": "en", "itemId": "treatment-dose-enoxaparin", "expect": "lmwh-treatment" },
    { "id": "pe-t-i04", "locale": "en", "query": "call the PE response team", "expect": "consult-pert" },
    { "id": "pe-t-i05", "locale": "en", "query": "give IV amiodarone 300 mg", "expect": null },
    { "id": "pe-t-i06", "locale": "zh-CN", "query": "抬高床头，让她半坐着", "expect": "positioning" },
    { "id": "pe-t-i07", "locale": "zh-CN", "query": "通知外科医生，讨论出血风险", "expect": "consult-surgeon" },
    { "id": "pe-t-i08", "locale": "zh-CN", "query": "静脉滴注扑热息痛止痛", "expect": "paracetamol" }
  ],
  "verifier": [
    { "id": "pe-t-v01", "locale": "en", "question": "When did it start?", "used": ["h-onset"], "reply": "About twenty minutes ago — around four, walking back from the toilet. It hit me all at once.", "expect": "pass" },
    { "id": "pe-t-v02", "locale": "en", "question": "When did it start?", "used": ["h-onset"], "reply": "About an hour ago, while I was lying in bed.", "expect": "block", "kind": "claim" },
    { "id": "pe-t-v03", "locale": "en", "question": "Did you have your blood-thinning injection?", "used": ["h-lmwh"], "reply": "The first two nights, yes. Last night they held it because the wound was weeping a bit.", "expect": "pass" },
    { "id": "pe-t-v04", "locale": "en", "question": "What medicines are you on?", "used": ["h-meds"], "reply": "Amlodipine 5 mg at home. Here it's paracetamol, plus tramadol when it's bad.", "expect": "block", "kind": "drug" },
    { "id": "pe-t-v05", "locale": "en", "question": "How bad is the pain?", "used": ["h-pain-severity"], "reply": "About a six — seven when I breathe in.", "expect": "pass" },
    { "id": "pe-t-v06", "locale": "en", "question": "Any problems with your lungs?", "used": [], "reply": "No, my lungs have always been healthy.", "expect": "block", "kind": "denial" },
    { "id": "pe-t-v07", "locale": "en", "question": "How much do you weigh?", "used": ["h-weight"], "reply": "They weighed me before the operation — 70 kilos.", "expect": "pass" },
    { "id": "pe-t-v08", "locale": "zh-CN", "question": "腿有没有不舒服？", "used": ["h-calf"], "reply": "右边小腿从昨天就有点胀痛、发紧，左腿没事。", "expect": "pass" },
    { "id": "pe-t-v09", "locale": "zh-CN", "question": "腿有没有不舒服？", "used": ["h-calf"], "reply": "两条腿都肿了，左腿更厉害。", "expect": "block", "kind": "claim" },
    { "id": "pe-t-v10", "locale": "zh-CN", "question": "家里人有血栓吗？", "used": ["h-family"], "reply": "没人得过血栓。我妈妈有高血压，我爸爸78岁时中风去世的。", "expect": "pass" },
    { "id": "pe-t-v11", "locale": "zh-CN", "question": "家里人有血栓吗？", "used": ["h-family"], "reply": "我姐姐前年得过下肢静脉血栓。", "expect": "block", "kind": "claim" },
    { "id": "pe-t-v12", "locale": "zh-CN", "question": "做的什么手术？", "used": ["h-surgery"], "reply": "三天前开腹切了右边一段肠子，因为长了肿瘤。医生说已经转移到肝了。", "expect": "block", "kind": "claim" }
  ]
}
