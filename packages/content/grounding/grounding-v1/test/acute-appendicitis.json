{
  "$schema": "../../../schemas/grounding-set.schema.json",
  "format": "clinicalcraft/grounding-set@1",
  "suite": "grounding-v1",
  "split": "test",
  "caseId": "acute-appendicitis",
  "history": [
    { "id": "app-t-h01", "locale": "en", "text": "So, what's been happening with your stomach?", "expect": ["hx-chief"] },
    { "id": "app-t-h02", "locale": "en", "text": "What time did the pain kick off yesterday?", "expect": ["hx-onset"] },
    { "id": "app-t-h03", "locale": "en", "text": "Where in your belly did it begin?", "expect": ["hx-site-initial"] },
    { "id": "app-t-h04", "locale": "en", "text": "Has the pain moved around since then?", "expect": ["hx-migration"] },
    { "id": "app-t-h05", "locale": "en", "text": "Is it a sharp pain or more of a dull ache?", "expect": ["hx-character"] },
    { "id": "app-t-h06", "locale": "en", "text": "Out of ten, what would you give the pain right now?", "expect": ["hx-severity"] },
    { "id": "app-t-h07", "locale": "en", "text": "Does it hurt more when you move about or cough?", "expect": ["hx-aggravating"] },
    { "id": "app-t-h08", "locale": "en", "text": "Have you thrown up at all?", "expect": ["hx-vomiting"] },
    { "id": "app-t-h09", "locale": "en", "text": "Any burning when you pee?", "expect": ["hx-urinary"] },
    { "id": "app-t-h10", "locale": "en", "text": "Have you lost any weight recently?", "expect": ["hx-chronic"] },
    { "id": "app-t-h11", "locale": "en", "text": "Do you happen to know your blood type?", "expect": ["hx-blood-group"] },
    { "id": "app-t-h12", "locale": "en", "text": "Do you have any pets?", "expect": [] },
    { "id": "app-t-h13", "locale": "en", "text": "Do you wear glasses?", "expect": [] },
    { "id": "app-t-h14", "locale": "zh-CN", "text": "肚子哪儿疼啊？", "expect": ["hx-migration"], "alsoOk": ["hx-chief", "hx-site-initial"] },
    { "id": "app-t-h15", "locale": "zh-CN", "text": "从什么时候开始疼的？", "expect": ["hx-onset"] },
    { "id": "app-t-h16", "locale": "zh-CN", "text": "疼得厉害吗？满分10分的话打几分？", "expect": ["hx-severity"] },
    { "id": "app-t-h17", "locale": "zh-CN", "text": "是一直疼还是一阵阵地疼？", "expect": ["hx-timing"] },
    { "id": "app-t-h18", "locale": "zh-CN", "text": "有什么姿势能让你舒服点吗？", "expect": ["hx-relieving"] },
    { "id": "app-t-h19", "locale": "zh-CN", "text": "还想吃东西吗？", "expect": ["hx-anorexia"] },
    { "id": "app-t-h20", "locale": "zh-CN", "text": "发烧了没有？", "expect": ["hx-fever"] },
    { "id": "app-t-h21", "locale": "zh-CN", "text": "拉肚子吗？大便正常吗？", "expect": ["hx-bowels"] },
    { "id": "app-t-h22", "locale": "zh-CN", "text": "以前做过什么手术没有？", "expect": ["hx-psh"] },
    { "id": "app-t-h23", "locale": "zh-CN", "text": "平时抽烟喝酒吗？", "expect": ["hx-substances"] },
    { "id": "app-t-h24", "locale": "zh-CN", "text": "家里人有什么遗传病吗？", "expect": ["hx-family"] },
    { "id": "app-t-h25", "locale": "zh-CN", "text": "你平时睡眠怎么样？", "expect": [] },
    { "id": "app-t-h26", "locale": "zh-CN", "text": "你会开车吗？", "expect": [] }
  ],
  "exam": [
    { "id": "app-t-e01", "locale": "en", "query": "palpate the abdomen gently, starting on the left", "expect": "ex-abd-palp" },
    { "id": "app-t-e02", "locale": "en", "query": "check for rebound tenderness", "expect": "ex-rebound" },
    { "id": "app-t-e03", "locale": "en", "itemId": "rovsing-sign", "expect": "ex-rovsing" },
    { "id": "app-t-e04", "locale": "en", "itemId": "psoas", "expect": "ex-psoas" },
    { "id": "app-t-e05", "locale": "zh-CN", "query": "听一下肠鸣音", "expect": "ex-bowel-sounds" },
    { "id": "app-t-e06", "locale": "zh-CN", "query": "检查有没有腹肌紧张", "expect": "ex-guarding" },
    { "id": "app-t-e07", "locale": "zh-CN", "query": "肛门指检", "expect": "ex-dre" },
    { "id": "app-t-e08", "locale": "zh-CN", "query": "看看有没有疝", "expect": "ex-hernia" }
  ],
  "orders": [
    { "id": "app-t-o01", "locale": "en", "query": "full blood count", "expect": "inv-fbc" },
    { "id": "app-t-o02", "locale": "en", "itemId": "crp", "expect": "inv-crp" },
    { "id": "app-t-o03", "locale": "en", "query": "ultrasound of the right lower quadrant", "expect": "inv-us" },
    { "id": "app-t-o04", "locale": "en", "itemId": "ct_abdomen_pelvis", "expect": "inv-ct" },
    { "id": "app-t-o05", "locale": "en", "query": "serum troponin", "expect": null },
    { "id": "app-t-o06", "locale": "zh-CN", "query": "查个尿常规", "expect": "inv-ua" },
    { "id": "app-t-o07", "locale": "zh-CN", "query": "肝功能和淀粉酶", "expect": "inv-lft-lipase" },
    { "id": "app-t-o08", "locale": "zh-CN", "query": "血型鉴定", "expect": "inv-group-screen" }
  ],
  "interventions": [
    { "id": "app-t-i01", "locale": "en", "query": "ondansetron 4 mg IV", "expect": "ondansetron" },
    { "id": "app-t-i02", "locale": "en", "query": "keep him nil by mouth", "expect": "npo" },
    { "id": "app-t-i03", "locale": "en", "itemId": "cefuroxime-metronidazole", "expect": "abx-cefuroxime-metronidazole" },
    { "id": "app-t-i04", "locale": "en", "itemId": "surgery_referral", "expect": "surgical-consult" },
    { "id": "app-t-i05", "locale": "en", "query": "give IV hydrocortisone 200 mg", "expect": null },
    { "id": "app-t-i06", "locale": "zh-CN", "query": "静脉滴注对乙酰氨基酚", "expect": "paracetamol" },
    { "id": "app-t-i07", "locale": "zh-CN", "query": "请外科会诊", "expect": "surgical-consult" },
    { "id": "app-t-i08", "locale": "zh-CN", "query": "下胃管减压", "expect": "ng-tube" }
  ],
  "verifier": [
    { "id": "app-t-v01", "locale": "en", "question": "When did it start?", "used": ["hx-onset"], "reply": "It started around 8 yesterday morning on my way to class. It crept up slowly, just a dull ache at first.", "expect": "pass" },
    { "id": "app-t-v02", "locale": "en", "question": "How bad is it out of ten?", "used": ["hx-severity"], "reply": "It's about a 5 right now, maybe a 6 when I cough.", "expect": "block", "kind": "number" },
    { "id": "app-t-v03", "locale": "en", "question": "Have you taken anything for it?", "used": ["hx-meds"], "reply": "I took two ibuprofen this morning but they didn't really help.", "expect": "block", "kind": "drug" },
    { "id": "app-t-v04", "locale": "en", "question": "Any heart or lung problems in your family?", "used": [], "reply": "No, nobody in my family has heart or lung problems.", "expect": "block", "kind": "denial" },
    { "id": "app-t-v05", "locale": "en", "question": "How are you feeling about all this?", "used": [], "reply": "Honestly, I'm a bit scared. I just want the pain to stop.", "expect": "pass" },
    { "id": "app-t-v06", "locale": "en", "question": "Have you had any serious illnesses?", "used": ["hx-pmh"], "reply": "I've always been healthy, apart from a kidney infection last year.", "expect": "block", "kind": "claim" },
    { "id": "app-t-v07", "locale": "en", "question": "Are you allergic to anything?", "used": ["hx-allergies"], "reply": "No allergies at all. I've had penicillin before and it was fine.", "expect": "pass" },
    { "id": "app-t-v08", "locale": "zh-CN", "question": "最后一次吃东西是什么时候？", "used": ["hx-last-intake"], "reply": "昨天早上七点半吃的早饭，一个面包加一盒牛奶，后来只喝了几口水。", "expect": "pass" },
    { "id": "app-t-v09", "locale": "zh-CN", "question": "现在疼得有多厉害？", "used": ["hx-severity"], "reply": "现在大概5分，动一下能到6分。", "expect": "block", "kind": "number" },
    { "id": "app-t-v10", "locale": "zh-CN", "question": "抽烟吗？", "used": ["hx-substances"], "reply": "不抽烟，偶尔喝点啤酒。我爸年轻的时候割过阑尾。", "expect": "block", "kind": "unasked" },
    { "id": "app-t-v11", "locale": "zh-CN", "question": "对什么药过敏吗？", "used": [], "reply": "没有，我对什么药都不过敏。", "expect": "block", "kind": "denial" }
  ]
}
