{
  "$schema": "../../../schemas/grounding-set.schema.json",
  "format": "clinicalcraft/grounding-set@1",
  "suite": "grounding-v1",
  "split": "test",
  "caseId": "dka-adult",
  "history": [
    { "id": "dka-t-h01", "locale": "en", "text": "What's the matter tonight?", "expect": ["hx-main-complaint"] },
    { "id": "dka-t-h02", "locale": "en", "text": "When did you first start feeling unwell?", "expect": ["hx-onset-course"] },
    { "id": "dka-t-h03", "locale": "en", "text": "Have you been able to keep any fluids down?", "expect": ["hx-oral-intake"], "alsoOk": ["hx-vomiting"] },
    { "id": "dka-t-h04", "locale": "en", "text": "Is there any blood in your vomit?", "expect": ["hx-vomiting"] },
    { "id": "dka-t-h05", "locale": "en", "text": "Where's the tummy pain?", "expect": ["hx-abd-pain"] },
    { "id": "dka-t-h06", "locale": "en", "text": "Are you peeing a lot more than normal?", "expect": ["hx-polyuria-thirst"] },
    { "id": "dka-t-h07", "locale": "en", "text": "Do you feel short of breath?", "expect": ["hx-breathing"] },
    { "id": "dka-t-h08", "locale": "en", "text": "What have your sugars been running at home?", "expect": ["hx-glucose-home"], "alsoOk": ["hx-unk-meter-readings"] },
    { "id": "dka-t-h09", "locale": "en", "text": "Has your pump been alarming?", "expect": ["hx-insulin-pump"] },
    { "id": "dka-t-h10", "locale": "en", "text": "When did you last change your cannula?", "expect": ["hx-infusion-set"] },
    { "id": "dka-t-h11", "locale": "en", "text": "Have you ever been on dapagliflozin or empagliflozin?", "expect": ["hx-sglt2"] },
    { "id": "dka-t-h12", "locale": "en", "text": "Have you ever had DKA before?", "expect": ["hx-previous-dka"], "alsoOk": ["hx-pmh"] },
    { "id": "dka-t-h13", "locale": "en", "text": "Do you smoke weed or take any drugs?", "expect": ["hx-recreational-drugs"] },
    { "id": "dka-t-h14", "locale": "en", "text": "Do you remember your last HbA1c?", "expect": ["hx-unk-hba1c"] },
    { "id": "dka-t-h15", "locale": "en", "text": "How are you feeling now compared with when you came in?", "phase": "glucose-lt14", "expect": ["hx-status-midway"] },
    { "id": "dka-t-h16", "locale": "en", "text": "Do you play any sport?", "expect": [] },
    { "id": "dka-t-h17", "locale": "en", "text": "Do you have a car?", "expect": [] },
    { "id": "dka-t-h18", "locale": "zh-CN", "text": "拉肚子吗？", "expect": ["hx-diarrhoea"] },
    { "id": "dka-t-h19", "locale": "zh-CN", "text": "有没有犯困、犯迷糊？", "expect": ["hx-drowsy"], "alsoOk": ["hx-ros-other"] },
    { "id": "dka-t-h20", "locale": "zh-CN", "text": "最近瘦了没有？", "expect": ["hx-weight-loss"], "alsoOk": ["hx-weight"] },
    { "id": "dka-t-h21", "locale": "zh-CN", "text": "在家测过酮体吗？", "expect": ["hx-ketones-home"] },
    { "id": "dka-t-h22", "locale": "zh-CN", "text": "不舒服这两天胰岛素是怎么打的？", "expect": ["hx-insulin-omitted"], "alsoOk": ["hx-insulin-pump"] },
    { "id": "dka-t-h23", "locale": "zh-CN", "text": "泵的基础率设的多少？", "expect": ["hx-pump-settings"] },
    { "id": "dka-t-h24", "locale": "zh-CN", "text": "医生教过你生病的时候胰岛素该怎么调吗？", "expect": ["hx-sick-day-rules"] },
    { "id": "dka-t-h25", "locale": "zh-CN", "text": "有没有发烧？", "expect": ["hx-fever"] },
    { "id": "dka-t-h26", "locale": "zh-CN", "text": "小便的时候痛不痛？", "expect": ["hx-urinary-symptoms"] },
    { "id": "dka-t-h27", "locale": "zh-CN", "text": "最近有没有咳嗽、嗓子疼？", "expect": ["hx-resp-infection"] },
    { "id": "dka-t-h28", "locale": "zh-CN", "text": "除了糖尿病还有什么病？", "expect": ["hx-pmh"] },
    { "id": "dka-t-h29", "locale": "zh-CN", "text": "你每天都吃哪些药？", "expect": ["hx-meds"], "alsoOk": ["hx-insulin-pump"] },
    { "id": "dka-t-h30", "locale": "zh-CN", "text": "上次来月经是什么时候？", "expect": ["hx-lmp-pregnancy"] },
    { "id": "dka-t-h31", "locale": "zh-CN", "text": "家里人有糖尿病吗？", "expect": ["hx-family"] },
    { "id": "dka-t-h32", "locale": "zh-CN", "text": "你多高多重？", "expect": ["hx-weight"] },
    { "id": "dka-t-h33", "locale": "zh-CN", "text": "你现在最担心什么？", "expect": ["hx-ice"] },
    { "id": "dka-t-h34", "locale": "zh-CN", "text": "你喜欢看电影吗？", "expect": [] },
    { "id": "dka-t-h35", "locale": "zh-CN", "text": "你养狗吗？", "expect": [] },
    { "id": "dka-t-n01", "locale": "en", "text": "You haven't been able to check your ketones at home, have you?", "expect": ["hx-ketones-home"], "tags": ["negation"] },
    { "id": "dka-t-n02", "locale": "zh-CN", "text": "没吃过格列净类的药吧？", "expect": ["hx-sglt2"], "alsoOk": ["hx-meds"], "tags": ["negation"] }
  ],
  "exam": [
    { "id": "dka-t-e01", "locale": "en", "query": "observe her respiratory pattern — is it Kussmaul?", "expect": "ex-breathing-pattern" },
    { "id": "dka-t-e02", "locale": "en", "query": "smell her breath for ketones", "expect": "ex-breath-odour" },
    { "id": "dka-t-e03", "locale": "en", "itemId": "insulin-pump-site", "expect": "ex-pump-site" },
    { "id": "dka-t-e04", "locale": "en", "query": "check mucous membranes and skin turgor", "expect": "ex-hydration" },
    { "id": "dka-t-e05", "locale": "zh-CN", "query": "腹部触诊", "expect": "ex-abdomen" },
    { "id": "dka-t-e06", "locale": "zh-CN", "query": "查一下肾区叩痛", "expect": "ex-renal-angle" },
    { "id": "dka-t-e07", "locale": "zh-CN", "query": "看看喉咙和耳朵", "expect": "ex-throat-ears" },
    { "id": "dka-t-e08", "locale": "zh-CN", "query": "称一下体重", "expect": "ex-weight" }
  ],
  "orders": [
    { "id": "dka-t-o01", "locale": "en", "query": "capillary ketones", "expect": "poc-ketones" },
    { "id": "dka-t-o02", "locale": "en", "itemId": "venous-blood-gas", "expect": "vbg" },
    { "id": "dka-t-o03", "locale": "en", "query": "U&Es, phosphate and magnesium", "expect": "chemistry" },
    { "id": "dka-t-o04", "locale": "en", "itemId": "beta-hcg", "expect": "urine-hcg" },
    { "id": "dka-t-o05", "locale": "en", "query": "serum ammonia", "expect": null },
    { "id": "dka-t-o06", "locale": "zh-CN", "query": "查淀粉酶和脂肪酶", "expect": "lipase" },
    { "id": "dka-t-o07", "locale": "zh-CN", "query": "抽血培养", "expect": "blood-cultures" },
    { "id": "dka-t-o08", "locale": "zh-CN", "query": "导出胰岛素泵的数据", "expect": "pump-download" },
    { "id": "dka-t-n06", "locale": "zh-CN", "query": "尿妊娠试验排除怀孕", "expect": "urine-hcg", "tags": ["negation"] }
  ],
  "interventions": [
    { "id": "dka-t-i01", "locale": "en", "query": "1 litre of normal saline over an hour", "expect": "nacl-1l-1h" },
    { "id": "dka-t-i02", "locale": "en", "query": "start fixed rate insulin at 0.1 units per kg per hour", "expect": "friii" },
    { "id": "dka-t-i03", "locale": "en", "itemId": "remove-insulin-pump", "expect": "suspend-pump" },
    { "id": "dka-t-i04", "locale": "en", "query": "refer her to HDU", "expect": "hdu-referral" },
    { "id": "dka-t-i05", "locale": "en", "query": "give IV furosemide 40 mg", "expect": null },
    { "id": "dka-t-i06", "locale": "zh-CN", "query": "止吐，用昂丹司琼", "expect": "ondansetron" },
    { "id": "dka-t-i07", "locale": "zh-CN", "query": "皮下打依诺肝素预防血栓", "expect": "vte-prophylaxis" },
    { "id": "dka-t-i08", "locale": "zh-CN", "query": "请糖尿病专科会诊", "expect": "diabetes-team-referral" },
    { "id": "dka-t-n03", "locale": "en", "query": "do not give potassium as an IV push", "expect": null, "tags": ["negation"] },
    { "id": "dka-t-n04", "locale": "zh-CN", "query": "停掉胰岛素泵", "expect": "suspend-pump", "tags": ["negation"] },
    { "id": "dka-t-n05", "locale": "en", "query": "no bicarbonate", "expect": null, "tags": ["negation"] }
  ],
  "verifier": [
    { "id": "dka-t-v01", "locale": "en", "question": "Have you checked your sugar at home?", "used": ["hx-glucose-home"], "reply": "Once, yesterday afternoon — it was about 24. The pump suggested a correction but I cancelled it because I wasn't eating.", "expect": "pass" },
    { "id": "dka-t-v02", "locale": "en", "question": "Have you checked your sugar at home?", "used": ["hx-glucose-home"], "reply": "Yes, it was 32 yesterday afternoon.", "expect": "block", "kind": "number" },
    { "id": "dka-t-v03", "locale": "en", "question": "Do you take any other medicines?", "used": ["hx-meds"], "reply": "Just levothyroxine, 50 micrograms every morning, but I couldn't keep it down yesterday.", "expect": "pass" },
    { "id": "dka-t-v04", "locale": "en", "question": "Do you take any other medicines?", "used": ["hx-meds"], "reply": "Levothyroxine, and metformin for my sugars.", "expect": "block", "kind": "drug" },
    { "id": "dka-t-v05", "locale": "en", "question": "Has your pump had any problems?", "used": ["hx-insulin-pump"], "reply": "It kept alarming 'occlusion' the night before last, and I just cleared it and went back to sleep.", "expect": "pass" },
    { "id": "dka-t-v06", "locale": "en", "question": "Any problems with your kidneys?", "used": [], "reply": "No, my kidneys have always been fine.", "expect": "block", "kind": "denial" },
    { "id": "dka-t-v07", "locale": "en", "question": "How much do you weigh?", "used": ["hx-weight"], "reply": "Usually about 57 kilos, and I'm 1.63 m tall.", "expect": "pass", "note": "faithful: the source says 'one metre sixty-three'" },
    { "id": "dka-t-v08", "locale": "zh-CN", "question": "吐了几次？", "used": ["hx-vomiting"], "reply": "从昨天到现在吐了六到八次，没有血。", "expect": "pass" },
    { "id": "dka-t-v09", "locale": "zh-CN", "question": "吐了几次？", "used": ["hx-vomiting"], "reply": "吐了十几次了，还吐出来一点血。", "expect": "block", "kind": "claim" },
    { "id": "dka-t-v10", "locale": "zh-CN", "question": "家里人有什么病？", "used": ["hx-family"], "reply": "我妈妈有甲状腺的毛病，我外公有2型糖尿病。", "expect": "block", "kind": "claim" },
    { "id": "dka-t-v11", "locale": "zh-CN", "question": "抽烟喝酒吗？", "used": ["hx-smoking-alcohol"], "reply": "不抽烟，酒很少喝，这周一点都没喝。", "expect": "pass" },
    { "id": "dka-t-v12", "locale": "zh-CN", "question": "泵是怎么设置的？", "used": ["hx-pump-settings"], "reply": "基础率每小时1.2单位，一天大概40个单位。", "expect": "block", "kind": "number" },
    { "id": "dka-t-n07", "locale": "en", "question": "Did you manage to check your ketones?", "used": ["hx-ketones-home"], "reply": "Yes, I checked them at home and they were high.", "expect": "block", "kind": "negation", "tags": ["negation"] },
    { "id": "dka-t-n08", "locale": "zh-CN", "question": "吐过吗？", "used": ["hx-vomiting"], "reply": "没有，一次都没吐过。", "expect": "block", "kind": "negation", "tags": ["negation"] },
    { "id": "dka-t-n09", "locale": "en", "question": "Have you had surgery before?", "used": ["hx-psh"], "reply": "No operations, ever.", "expect": "pass", "tags": ["negation"] },
    { "id": "dka-t-n10", "locale": "zh-CN", "question": "小便有没有烧灼感？", "used": ["hx-urinary-symptoms"], "reply": "不疼也不烧，就是尿多。", "expect": "pass", "tags": ["negation"] }
  ]
}
