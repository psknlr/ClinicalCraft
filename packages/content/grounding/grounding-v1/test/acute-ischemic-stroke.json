{
  "$schema": "../../../schemas/grounding-set.schema.json",
  "format": "clinicalcraft/grounding-set@1",
  "suite": "grounding-v1",
  "split": "test",
  "caseId": "acute-ischemic-stroke",
  "history": [
    { "id": "str-t-h01", "locale": "en", "text": "Can you tell me what happened?", "expect": ["pc-what-happened"] },
    { "id": "str-t-h02", "locale": "en", "text": "What time was he last definitely well?", "expect": ["lkw"] },
    { "id": "str-t-h03", "locale": "en", "text": "Were you with him when it actually started?", "expect": ["onset-witness"] },
    { "id": "str-t-h04", "locale": "en", "text": "Has he got any better or worse since you found him?", "expect": ["course-since"] },
    { "id": "str-t-h05", "locale": "en", "text": "Did he bang his head when it happened?", "expect": ["head-trauma"] },
    { "id": "str-t-h06", "locale": "en", "text": "Has he complained of a headache or been sick?", "expect": ["headache-vomiting"] },
    { "id": "str-t-h07", "locale": "en", "text": "Was there any fitting or jerking of his arms and legs?", "expect": ["loc-seizure"] },
    { "id": "str-t-h08", "locale": "en", "text": "Has he ever had a mini-stroke before?", "expect": ["prior-tia"], "alsoOk": ["prior-stroke"] },
    { "id": "str-t-h09", "locale": "en", "text": "Is he on any blood thinners like warfarin or apixaban?", "expect": ["anticoagulants"], "alsoOk": ["medications"] },
    { "id": "str-t-h10", "locale": "en", "text": "Has he ever been told he has an irregular heartbeat?", "expect": ["pmh-af"], "alsoOk": ["palpitations"] },
    { "id": "str-t-h11", "locale": "en", "text": "Do you know his weight?", "expect": ["weight"] },
    { "id": "str-t-h12", "locale": "en", "text": "Which hand does he write with?", "expect": ["handedness"] },
    { "id": "str-t-h13", "locale": "en", "text": "Has he ever been a smoker?", "expect": ["smoking"] },
    { "id": "str-t-h14", "locale": "en", "text": "Could he manage on his own before this — shopping, cooking, getting about?", "expect": ["functional-baseline"] },
    { "id": "str-t-h15", "locale": "en", "text": "Did anyone check his blood pressure at home today?", "expect": ["unknown-bp-today"] },
    { "id": "str-t-h16", "locale": "en", "text": "Does he have any tattoos?", "expect": [] },
    { "id": "str-t-h17", "locale": "en", "text": "Which football team does he support?", "expect": [] },
    { "id": "str-t-h18", "locale": "zh-CN", "text": "他平时血压高不高？", "expect": ["pmh-htn"] },
    { "id": "str-t-h19", "locale": "zh-CN", "text": "他平常都吃些什么药？", "expect": ["medications"], "alsoOk": ["anticoagulants"] },
    { "id": "str-t-h20", "locale": "zh-CN", "text": "有没有药物过敏？", "expect": ["allergies"] },
    { "id": "str-t-h21", "locale": "zh-CN", "text": "最近有没有做过手术或者拔过牙？", "expect": ["recent-surgery"] },
    { "id": "str-t-h22", "locale": "zh-CN", "text": "以前有没有出过血，比如胃出血、便血？", "expect": ["bleeding-history"] },
    { "id": "str-t-h23", "locale": "zh-CN", "text": "今天最后一顿饭是几点吃的？", "expect": ["last-meal"] },
    { "id": "str-t-h24", "locale": "zh-CN", "text": "平时喝不喝酒？", "expect": ["alcohol"] },
    { "id": "str-t-h25", "locale": "zh-CN", "text": "他父母身体怎么样？家里有中风的吗？", "expect": ["family-history"], "alsoOk": ["unknown-father-stroke-type"] },
    { "id": "str-t-h26", "locale": "zh-CN", "text": "最近有没有感冒发烧？", "expect": ["recent-illness"] },
    { "id": "str-t-h27", "locale": "zh-CN", "text": "您现在心里最怕的是什么？", "expect": ["ice-concerns"] },
    { "id": "str-t-h28", "locale": "zh-CN", "text": "他退休前是干什么的？", "expect": ["social-living"] },
    { "id": "str-t-h29", "locale": "zh-CN", "text": "他血糖高不高？", "expect": ["pmh-other"] },
    { "id": "str-t-h30", "locale": "zh-CN", "text": "他胆固醇高吗？", "expect": ["unknown-lipids"] },
    { "id": "str-t-h31", "locale": "zh-CN", "text": "他喜欢吃辣吗？", "expect": [] },
    { "id": "str-t-h32", "locale": "zh-CN", "text": "他会游泳吗？", "expect": [] }
  ],
  "exam": [
    { "id": "str-t-e01", "locale": "en", "query": "perform a full NIH stroke scale", "expect": "nihss" },
    { "id": "str-t-e02", "locale": "en", "itemId": "pronator-drift", "expect": "arm-motor" },
    { "id": "str-t-e03", "locale": "en", "query": "check his visual fields", "expect": "visual-fields" },
    { "id": "str-t-e04", "locale": "en", "itemId": "carotid_bruit", "expect": "neck-carotid" },
    { "id": "str-t-e05", "locale": "zh-CN", "query": "看看他能不能说话、能不能听懂指令", "expect": "speech-language" },
    { "id": "str-t-e06", "locale": "zh-CN", "query": "量一下两侧胳膊的血压", "expect": "bilateral-bp" },
    { "id": "str-t-e07", "locale": "zh-CN", "query": "查一下双侧巴氏征", "expect": "tone-reflexes" },
    { "id": "str-t-e08", "locale": "zh-CN", "query": "让他笑一下看看口角歪不歪", "expect": "face" }
  ],
  "orders": [
    { "id": "str-t-o01", "locale": "en", "query": "bedside glucose", "expect": "poc-glucose" },
    { "id": "str-t-o02", "locale": "en", "itemId": "ct-head-noncontrast", "expect": "ct-head" },
    { "id": "str-t-o03", "locale": "en", "query": "CT angiogram of the head and neck vessels", "expect": "cta-head-neck" },
    { "id": "str-t-o04", "locale": "en", "itemId": "inr", "expect": "coag" },
    { "id": "str-t-o05", "locale": "en", "query": "lumbar puncture", "expect": null },
    { "id": "str-t-o06", "locale": "zh-CN", "query": "做个心电图", "expect": "ecg-12lead" },
    { "id": "str-t-o07", "locale": "zh-CN", "query": "做个心脏彩超", "expect": "echo-tte" },
    { "id": "str-t-o08", "locale": "zh-CN", "query": "抽血查血常规和血小板", "expect": "cbc" }
  ],
  "interventions": [
    { "id": "str-t-i01", "locale": "en", "query": "start IV alteplase at 0.9 mg/kg", "expect": "alteplase" },
    { "id": "str-t-i02", "locale": "en", "query": "labetalol 10 mg IV to bring the BP down", "expect": "labetalol" },
    { "id": "str-t-i03", "locale": "en", "itemId": "thrombectomy-team", "expect": "evt-activate" },
    { "id": "str-t-i04", "locale": "en", "query": "keep him nil by mouth until a swallow screen is done", "expect": "swallow-screen" },
    { "id": "str-t-i05", "locale": "en", "query": "start an IV insulin infusion", "expect": null },
    { "id": "str-t-i06", "locale": "zh-CN", "query": "启动卒中绿色通道", "expect": "stroke-code" },
    { "id": "str-t-i07", "locale": "zh-CN", "query": "跟家属谈溶栓的风险并签字", "expect": "consent-lysis" },
    { "id": "str-t-i08", "locale": "zh-CN", "query": "上心电监护", "expect": "cardiac-monitoring" }
  ],
  "verifier": [
    { "id": "str-t-v01", "locale": "en", "question": "When was he last normal?", "used": ["lkw"], "reply": "He was fine at five to nine — I was talking to him just before I went out to hang the washing, and I found him like this at about ten past nine.", "expect": "pass" },
    { "id": "str-t-v02", "locale": "en", "question": "When was he last normal?", "used": ["lkw"], "reply": "He was last normal at about 8:30, right after breakfast.", "expect": "block", "kind": "number" },
    { "id": "str-t-v03", "locale": "en", "question": "What medicines is he on?", "used": ["medications"], "reply": "Just amlodipine 5 mg every morning, and a calcium tablet with vitamin D.", "expect": "pass" },
    { "id": "str-t-v04", "locale": "en", "question": "What medicines is he on?", "used": ["medications"], "reply": "Amlodipine 5 mg in the morning, and he takes a baby aspirin every day too.", "expect": "block", "kind": "drug" },
    { "id": "str-t-v05", "locale": "en", "question": "Does he smoke?", "used": ["smoking"], "reply": "He used to smoke a pack a day for thirty years, but he gave up ten years ago.", "expect": "pass" },
    { "id": "str-t-v06", "locale": "en", "question": "Does he smoke?", "used": ["smoking"], "reply": "He quit ten years ago. He also had a heart attack a few years back.", "expect": "block", "kind": "claim" },
    { "id": "str-t-v07", "locale": "en", "question": "Any problems with his heart?", "used": [], "reply": "No, his heart has always been perfectly fine.", "expect": "block", "kind": "denial" },
    { "id": "str-t-v08", "locale": "zh-CN", "question": "他有多重？", "used": ["weight"], "reply": "上个月社区体检称的，80公斤，身高一米七二。", "expect": "pass" },
    { "id": "str-t-v09", "locale": "zh-CN", "question": "他有多重？", "used": ["weight"], "reply": "大概75公斤吧。", "expect": "block", "kind": "number" },
    { "id": "str-t-v10", "locale": "zh-CN", "question": "家里人有中风的吗？", "used": ["family-history"], "reply": "他爸七十二岁中风，瘫了好几年。他哥哥也有糖尿病。", "expect": "block", "kind": "claim" },
    { "id": "str-t-v11", "locale": "zh-CN", "question": "他对什么过敏吗？", "used": ["allergies"], "reply": "没有，没听说他对什么药或者吃的过敏。", "expect": "pass" },
    { "id": "str-t-v12", "locale": "zh-CN", "question": "他有没有糖尿病？", "used": [], "reply": "没有，他血糖一直很正常。", "expect": "block", "kind": "denial" }
  ]
}
