{
  "$schema": "../../../schemas/grounding-set.schema.json",
  "format": "clinicalcraft/grounding-set@1",
  "suite": "grounding-v1",
  "split": "test",
  "caseId": "smzl-lung-adeno",
  "history": [
    { "id": "smz-t-h01", "locale": "en", "text": "Where is the pain?", "expect": ["pain"] },
    { "id": "smz-t-h02", "locale": "en", "text": "Has anyone ever told you your spleen was big?", "expect": ["spleen"] },
    { "id": "smz-t-h03", "locale": "en", "text": "Tell me about your lung cancer.", "expect": ["lung"] },
    { "id": "smz-t-h04", "locale": "en", "text": "Have you ever smoked cigarettes?", "expect": ["other"] },
    { "id": "smz-t-h05", "locale": "en", "text": "Are you on any blood pressure tablets?", "expect": ["pmh-htn"], "alsoOk": ["meds"] },
    { "id": "smz-t-h06", "locale": "en", "text": "What tablets do you take?", "expect": ["meds"], "alsoOk": ["pmh-htn", "lung"] },
    { "id": "smz-t-h07", "locale": "en", "text": "Any drug allergies?", "expect": ["allergies"] },
    { "id": "smz-t-h08", "locale": "en", "text": "What treatment have you had since the diagnosis?", "phase": "post", "expect": ["treatment-course"] },
    { "id": "smz-t-h09", "locale": "en", "text": "Do you have grandchildren?", "expect": [] },
    { "id": "smz-t-h10", "locale": "en", "text": "Do you play golf?", "expect": [] },
    { "id": "smz-t-h11", "locale": "zh-CN", "text": "以前开过刀吗？", "expect": ["psh"] },
    { "id": "smz-t-h12", "locale": "zh-CN", "text": "发过烧没有？", "expect": ["fever"] },
    { "id": "smz-t-h13", "locale": "zh-CN", "text": "家里有人得过癌症吗？", "expect": ["other"] },
    { "id": "smz-t-h14", "locale": "zh-CN", "text": "有没有高血压？", "expect": ["pmh-htn"] },
    { "id": "smz-t-h15", "locale": "zh-CN", "text": "阿美替尼现在吃多少？", "phase": "post", "expect": ["meds-post"] },
    { "id": "smz-t-h16", "locale": "zh-CN", "text": "治疗以后手脚麻不麻？", "phase": "post", "expect": ["numbness"] },
    { "id": "smz-t-h17", "locale": "zh-CN", "text": "最近胃口、睡眠怎么样？", "phase": "post", "expect": ["general-since-onset"] },
    { "id": "smz-t-h18", "locale": "zh-CN", "text": "您退休前做什么工作？", "expect": [] },
    { "id": "smz-t-h19", "locale": "zh-CN", "text": "您喜欢钓鱼吗？", "expect": [] },
    { "id": "smz-t-n01", "locale": "en", "text": "Apart from the lung cancer, no other tumours?", "expect": ["lung"], "tags": ["negation"] },
    { "id": "smz-t-n02", "locale": "zh-CN", "text": "没有发过烧吧？", "expect": ["fever"], "tags": ["negation"] }
  ],
  "exam": [
    { "id": "smz-t-e01", "locale": "en", "query": "feel for the spleen", "phase": "post", "expect": "exam-abdomen" },
    { "id": "smz-t-e02", "locale": "en", "itemId": "lymph-nodes", "phase": "post", "expect": "exam-nodes" },
    { "id": "smz-t-e03", "locale": "en", "query": "check his vital signs", "phase": "post", "expect": "exam-vitals" },
    { "id": "smz-t-e04", "locale": "zh-CN", "query": "神经系统查体，看看手脚感觉", "phase": "post", "expect": "exam-neuro" },
    { "id": "smz-t-e05", "locale": "zh-CN", "query": "听听肺", "phase": "post", "expect": "exam-lungs" }
  ],
  "orders": [
    { "id": "smz-t-o01", "locale": "en", "query": "complete blood count", "expect": "cbc" },
    { "id": "smz-t-o02", "locale": "en", "query": "bone marrow trephine with immunohistochemistry", "expect": "biopsy" },
    { "id": "smz-t-o03", "locale": "en", "itemId": "flow-cytometry", "expect": "flow" },
    { "id": "smz-t-o04", "locale": "en", "query": "HBV DNA viral load", "expect": "hbv" },
    { "id": "smz-t-o05", "locale": "en", "query": "serum protein electrophoresis", "expect": null },
    { "id": "smz-t-o06", "locale": "zh-CN", "query": "做个腹部增强CT", "expect": "abdct" },
    { "id": "smz-t-o07", "locale": "zh-CN", "query": "骨髓穿刺涂片", "expect": "marrow" },
    { "id": "smz-t-o08", "locale": "zh-CN", "query": "查一下乳酸脱氢酶", "expect": "ldh" },
    { "id": "smz-t-n03", "locale": "en", "query": "EGFR result — positive or negative?", "expect": "egfr", "tags": ["negation"] },
    { "id": "smz-t-n04", "locale": "zh-CN", "query": "乙肝筛查，排除乙肝", "expect": "hbv", "tags": ["negation"] }
  ],
  "verifier": [
    { "id": "smz-t-v01", "locale": "en", "question": "When was your enlarged spleen found?", "used": ["spleen"], "reply": "About 30 years ago, and the PET/CT in November 2024 showed it was still markedly enlarged.", "expect": "pass" },
    { "id": "smz-t-v02", "locale": "en", "question": "When was your enlarged spleen found?", "used": ["spleen"], "reply": "About 10 years ago, on a routine ultrasound.", "expect": "block", "kind": "number" },
    { "id": "smz-t-v03", "locale": "en", "question": "What medicines do you take?", "used": ["meds"], "reply": "Levamlodipine for my blood pressure, and aumolertinib — 55 mg on odd days and 110 mg on even days.", "expect": "pass" },
    { "id": "smz-t-v04", "locale": "en", "question": "What medicines do you take?", "used": ["meds"], "reply": "Levamlodipine, aumolertinib, and osimertinib as well.", "expect": "block", "kind": "drug" },
    { "id": "smz-t-v05", "locale": "en", "question": "Do you smoke?", "used": ["other"], "reply": "I smoked for about 40 years but stopped when I was diagnosed.", "expect": "block", "kind": "claim" },
    { "id": "smz-t-v06", "locale": "zh-CN", "question": "做过手术吗？", "used": ["psh"], "reply": "胆囊以前切除了，什么时候做的病例里没有记录。", "expect": "pass" },
    { "id": "smz-t-v07", "locale": "zh-CN", "question": "做过手术吗？", "used": ["psh"], "reply": "2015年因为胆结石把胆囊切了。", "expect": "block", "kind": "number" },
    { "id": "smz-t-v08", "locale": "zh-CN", "question": "对药物过敏吗？", "used": ["allergies"], "reply": "没有药物过敏，也没有食物过敏。", "expect": "pass" },
    { "id": "smz-t-v09", "locale": "zh-CN", "question": "有没有其他慢性病？", "used": ["pmh-htn"], "reply": "有高血压好多年了，还有糖尿病。", "expect": "block", "kind": "claim" },
    { "id": "smz-t-n05", "locale": "en", "question": "What did the gene test on your lung cancer show?", "used": ["lung"], "reply": "The EGFR test was negative — no mutation was found.", "expect": "block", "kind": "negation", "tags": ["negation"] },
    { "id": "smz-t-n06", "locale": "zh-CN", "question": "对药物过敏吗？", "used": ["allergies"], "reply": "有，我对青霉素过敏。", "expect": "block", "kind": "negation", "tags": ["negation"] },
    { "id": "smz-t-n07", "locale": "en", "question": "Any allergies?", "used": ["allergies"], "reply": "No allergies to drugs or food.", "expect": "pass", "tags": ["negation"] },
    { "id": "smz-t-n08", "locale": "zh-CN", "question": "肺癌的基因检测结果怎么样？", "used": ["lung"], "reply": "记录上写的是EGFR突变阳性，我在吃阿美替尼。", "expect": "pass", "tags": ["negation"] }
  ]
}
