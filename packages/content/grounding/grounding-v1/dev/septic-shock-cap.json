{
  "$schema": "../../../schemas/grounding-set.schema.json",
  "format": "clinicalcraft/grounding-set@1",
  "suite": "grounding-v1",
  "split": "dev",
  "caseId": "septic-shock-cap",
  "history": [
    {"id": "sep-d-h01", "locale": "en", "text": "Any pain in her chest?", "expect": ["hx-chest-pain"]},
    {"id": "sep-d-h02", "locale": "en", "text": "Is the pain worse when she breathes in?", "expect": ["hx-pain-modifiers"]},
    {"id": "sep-d-h03", "locale": "en", "text": "Is she coughing up phlegm?", "expect": ["hx-cough"]},
    {"id": "sep-d-h04", "locale": "en", "text": "Is she more breathless than usual?", "expect": ["hx-dyspnoea"]},
    {"id": "sep-d-h05", "locale": "en", "text": "Is she normally sharp?", "expect": ["hx-confusion"]},
    {"id": "sep-d-h06", "locale": "en", "text": "Any vomiting or diarrhoea?", "expect": ["hx-gi"]},
    {"id": "sep-d-h07", "locale": "en", "text": "Has she been dizzy?", "expect": ["hx-cvs-sx"]},
    {"id": "sep-d-h08", "locale": "en", "text": "Has she been aching all over?", "expect": ["hx-flu-sx"]},
    {"id": "sep-d-h09", "locale": "en", "text": "Has anyone at home been ill?", "expect": ["hx-sick-contacts"]},
    {"id": "sep-d-h10", "locale": "en", "text": "Any allergies?", "expect": ["hx-allergies"]},
    {"id": "sep-d-h11", "locale": "en", "text": "Does she have diabetes?", "expect": ["hx-pmh"]},
    {"id": "sep-d-h12", "locale": "en", "text": "What medicines does she take?", "expect": ["hx-meds"], "alsoOk": ["hx-otc-ibuprofen"]},
    {"id": "sep-d-h13", "locale": "en", "text": "How much does she weigh?", "expect": ["hx-weight"]},
    {"id": "sep-d-h14", "locale": "en", "text": "Does she sing?", "expect": []},
    {"id": "sep-d-h15", "locale": "zh-CN", "text": "发烧几天了？", "expect": ["hx-fever"]},
    {"id": "sep-d-h16", "locale": "zh-CN", "text": "打过寒战吗？", "expect": ["hx-rigors"]},
    {"id": "sep-d-h17", "locale": "zh-CN", "text": "痰里有血吗？", "expect": ["hx-haemoptysis"], "alsoOk": ["hx-cough"]},
    {"id": "sep-d-h18", "locale": "zh-CN", "text": "今天小便多少？", "expect": ["hx-intake-urine"]},
    {"id": "sep-d-h19", "locale": "zh-CN", "text": "小便疼吗？", "expect": ["hx-urinary"]},
    {"id": "sep-d-h20", "locale": "zh-CN", "text": "头疼吗？脖子硬吗？", "expect": ["hx-headache-neck"]},
    {"id": "sep-d-h21", "locale": "zh-CN", "text": "有没有半边身子没力气？", "expect": ["hx-neuro-sx"]},
    {"id": "sep-d-h22", "locale": "zh-CN", "text": "最近住过院吗？", "expect": ["hx-recent-healthcare"]},
    {"id": "sep-d-h23", "locale": "zh-CN", "text": "以前有慢支或者哮喘吗？", "expect": ["hx-lung-disease"]},
    {"id": "sep-d-h24", "locale": "zh-CN", "text": "心脏有没有毛病？", "expect": ["hx-heart-kidney"]},
    {"id": "sep-d-h25", "locale": "zh-CN", "text": "她抽烟吗？", "expect": ["hx-smoking"]},
    {"id": "sep-d-h26", "locale": "zh-CN", "text": "家里有遗传病吗？", "expect": ["hx-family"]},
    {"id": "sep-d-h27", "locale": "zh-CN", "text": "以前有没有消瘦、盗汗？", "expect": ["hx-tb-weightloss"]},
    {"id": "sep-d-h28", "locale": "zh-CN", "text": "如果病情加重，家里希望怎么治？", "expect": ["hx-goals-care"]},
    {"id": "sep-d-h29", "locale": "zh-CN", "text": "你们最担心什么？", "expect": ["hx-ice"]},
    {"id": "sep-d-h30", "locale": "zh-CN", "text": "您叫什么名字？", "expect": ["hx-identity"]},
    {"id": "sep-d-h31", "locale": "zh-CN", "text": "她会织毛衣吗？", "expect": []}
  ],
  "exam": [
    {"id": "sep-d-e01", "locale": "en", "query": "listen to her lungs", "expect": "ex-resp-ausc"},
    {"id": "sep-d-e02", "locale": "en", "query": "auscultate chest", "expect": "ex-resp-ausc"},
    {"id": "sep-d-e03", "locale": "en", "query": "check capillary refill time", "expect": "ex-perfusion"},
    {"id": "sep-d-e04", "locale": "en", "query": "assess GCS and orientation", "expect": "ex-neuro"},
    {"id": "sep-d-e05", "locale": "en", "query": "look for neck stiffness", "expect": "ex-meningism"},
    {"id": "sep-d-e06", "locale": "en", "query": "examine the abdomen", "expect": "ex-abdomen"},
    {"id": "sep-d-e07", "locale": "en", "query": "cardiovascular examination", "expect": "ex-cardiac"},
    {"id": "sep-d-e08", "locale": "en", "itemId": "resp-ausc", "expect": "ex-resp-ausc"},
    {"id": "sep-d-e09", "locale": "en", "itemId": "lung_auscultation", "expect": "ex-resp-ausc"},
    {"id": "sep-d-e10", "locale": "en", "query": "check for rash or petechiae", "expect": "ex-skin"},
    {"id": "sep-d-e11", "locale": "zh-CN", "query": "听诊双肺", "expect": "ex-resp-ausc"},
    {"id": "sep-d-e12", "locale": "zh-CN", "query": "查毛细血管再充盈", "expect": "ex-perfusion"},
    {"id": "sep-d-e13", "locale": "zh-CN", "query": "腹部查体", "expect": "ex-abdomen"}
  ],
  "orders": [
    {"id": "sep-d-o01", "locale": "en", "query": "blood cultures x2", "expect": "blood-cultures"},
    {"id": "sep-d-o02", "locale": "en", "query": "serum lactate", "expect": "vbg-lactate"},
    {"id": "sep-d-o03", "locale": "en", "query": "chest x-ray", "expect": "cxr"},
    {"id": "sep-d-o04", "locale": "en", "query": "FBC", "expect": "cbc"},
    {"id": "sep-d-o05", "locale": "en", "query": "U&Es", "expect": "chem"},
    {"id": "sep-d-o06", "locale": "en", "query": "procalcitonin", "expect": "crp-pct"},
    {"id": "sep-d-o07", "locale": "en", "itemId": "blood_cultures", "expect": "blood-cultures"},
    {"id": "sep-d-o08", "locale": "en", "itemId": "lactate", "expect": "vbg-lactate"},
    {"id": "sep-d-o09", "locale": "en", "itemId": "chest-xray", "expect": "cxr"},
    {"id": "sep-d-o10", "locale": "en", "itemId": "urine-legionella-antigen", "expect": "urine-antigens"},
    {"id": "sep-d-o11", "locale": "en", "query": "12 lead ECG", "expect": "ecg"},
    {"id": "sep-d-o12", "locale": "en", "query": "Bedside echo", "expect": "pocus"},
    {"id": "sep-d-o13", "locale": "zh-CN", "query": "血培养两套", "expect": "blood-cultures"},
    {"id": "sep-d-o14", "locale": "zh-CN", "query": "查个乳酸", "expect": "vbg-lactate"},
    {"id": "sep-d-o15", "locale": "zh-CN", "query": "床旁胸片", "expect": "cxr"},
    {"id": "sep-d-o16", "locale": "en", "query": "serum ferritin", "expect": null}
  ],
  "interventions": [
    {"id": "sep-d-i01", "locale": "en", "query": "30 ml/kg crystalloid bolus", "expect": "fluid-bolus"},
    {"id": "sep-d-i02", "locale": "en", "query": "start noradrenaline infusion", "expect": "norepinephrine"},
    {"id": "sep-d-i03", "locale": "en", "query": "IV ceftriaxone 2g", "expect": "abx-ceftriaxone"},
    {"id": "sep-d-i04", "locale": "en", "query": "azithromycin 500mg IV", "expect": "abx-azithromycin"},
    {"id": "sep-d-i05", "locale": "en", "itemId": "ceftriaxone", "expect": "abx-ceftriaxone"},
    {"id": "sep-d-i06", "locale": "en", "itemId": "norad", "expect": "norepinephrine"},
    {"id": "sep-d-i07", "locale": "en", "itemId": "fluids", "expect": "fluid-bolus"},
    {"id": "sep-d-i08", "locale": "en", "query": "insert two large bore cannulas", "expect": "iv-access"},
    {"id": "sep-d-i09", "locale": "en", "query": "refer to intensive care", "expect": "icu-referral"},
    {"id": "sep-d-i10", "locale": "en", "query": "insert a urinary catheter", "expect": "urinary-catheter"},
    {"id": "sep-d-i11", "locale": "en", "query": "oxygen via nasal cannula", "expect": "o2-nasal"},
    {"id": "sep-d-i12", "locale": "zh-CN", "query": "头孢曲松2g静滴", "expect": "abx-ceftriaxone"},
    {"id": "sep-d-i13", "locale": "zh-CN", "query": "去甲肾上腺素泵入", "expect": "norepinephrine"},
    {"id": "sep-d-i14", "locale": "zh-CN", "query": "补液500ml", "expect": "fluid-bolus"},
    {"id": "sep-d-i15", "locale": "en", "query": "IV immunoglobulin", "expect": null}
  ],
  "verifier": [
    {"id": "sep-d-v01", "locale": "en", "question": "When did the confusion start?", "used": ["hx-confusion"], "reply": "(Daughter) From about 3 or 4 this afternoon — she asked me if it was morning.", "expect": "pass"},
    {"id": "sep-d-v02", "locale": "en", "question": "When did the confusion start?", "used": ["hx-confusion"], "reply": "(Daughter) Since yesterday morning — she didn't recognise me at all.", "expect": "block", "kind": "claim"},
    {"id": "sep-d-v03", "locale": "zh-CN", "question": "以前有什么病？", "used": ["hx-pmh"], "reply": "（女儿）高血压十来年，糖尿病五六年，都在社区医院开药。", "expect": "pass"},
    {"id": "sep-d-v04", "locale": "zh-CN", "question": "以前有什么病？", "used": ["hx-pmh"], "reply": "（女儿）高血压、糖尿病，还有冠心病，放过两个支架。", "expect": "block", "kind": "claim"},
    {"id": "sep-d-v05", "locale": "zh-CN", "question": "对什么过敏吗？", "used": ["hx-allergies"], "reply": "（女儿）没有已知过敏，青霉素、头孢都用过，没出过问题。", "expect": "pass"},
    {"id": "sep-d-v06", "locale": "en", "question": "Does she have heart failure?", "used": [], "reply": "(Daughter) No, her heart is fine.", "expect": "block", "kind": "denial", "note": "true in the case, but the voice was not given the fact"}
  ]
}
