{
  "$schema": "../../../schemas/grounding-set.schema.json",
  "format": "clinicalcraft/grounding-set@1",
  "suite": "grounding-v1",
  "split": "dev",
  "caseId": "dka-adult",
  "history": [
    {"id": "dka-d-h01", "locale": "en", "text": "Tell me what's been going on.", "expect": ["hx-main-complaint"], "alsoOk": ["hx-onset-course"]},
    {"id": "dka-d-h02", "locale": "en", "text": "When did you last have a proper meal?", "expect": ["hx-oral-intake"]},
    {"id": "dka-d-h03", "locale": "en", "text": "How many times have you vomited?", "expect": ["hx-vomiting"]},
    {"id": "dka-d-h04", "locale": "en", "text": "Any loose stools?", "expect": ["hx-diarrhoea"]},
    {"id": "dka-d-h05", "locale": "en", "text": "How bad is the tummy pain, out of ten?", "expect": ["hx-abd-pain"]},
    {"id": "dka-d-h06", "locale": "en", "text": "Does anything ease the pain?", "expect": ["hx-pain-modifiers"]},
    {"id": "dka-d-h07", "locale": "en", "text": "Are you very thirsty?", "expect": ["hx-polyuria-thirst"]},
    {"id": "dka-d-h08", "locale": "en", "text": "Have you been feeling drowsy?", "expect": ["hx-drowsy"]},
    {"id": "dka-d-h09", "locale": "en", "text": "Do you have ketone strips at home?", "expect": ["hx-ketones-home"]},
    {"id": "dka-d-h10", "locale": "en", "text": "Have you been skipping your bolus doses?", "expect": ["hx-insulin-omitted"]},
    {"id": "dka-d-h11", "locale": "en", "text": "Any eye or kidney problems from your diabetes?", "expect": ["hx-complications"]},
    {"id": "dka-d-h12", "locale": "en", "text": "Do you like hiking?", "expect": []},
    {"id": "dka-d-h13", "locale": "zh-CN", "text": "有没有头痛、看东西模糊？", "expect": ["hx-ros-other"]},
    {"id": "dka-d-h14", "locale": "zh-CN", "text": "测过血糖吗？多少？", "expect": ["hx-glucose-home"]},
    {"id": "dka-d-h15", "locale": "zh-CN", "text": "管路几天没换了？", "expect": ["hx-infusion-set"]},
    {"id": "dka-d-h16", "locale": "zh-CN", "text": "有没有吃过达格列净？", "expect": ["hx-sglt2"]},
    {"id": "dka-d-h17", "locale": "zh-CN", "text": "以前因为糖尿病住过院吗？", "expect": ["hx-previous-dka"]},
    {"id": "dka-d-h18", "locale": "zh-CN", "text": "做过手术吗？", "expect": ["hx-psh"]},
    {"id": "dka-d-h19", "locale": "zh-CN", "text": "你有药物过敏吗？", "expect": ["hx-allergies"]},
    {"id": "dka-d-h20", "locale": "zh-CN", "text": "烟酒沾不沾？", "expect": ["hx-smoking-alcohol"]},
    {"id": "dka-d-h21", "locale": "zh-CN", "text": "你室友得的什么病？", "expect": ["hx-unk-roommate-dx"], "alsoOk": ["hx-sick-contacts"]},
    {"id": "dka-d-h22", "locale": "zh-CN", "text": "现在能吃点东西了吗？", "phase": "resolution", "expect": ["hx-status-resolution"]},
    {"id": "dka-d-h23", "locale": "zh-CN", "text": "你喜欢什么颜色？", "expect": []}
  ],
  "exam": [
    {"id": "dka-d-e01", "locale": "en", "query": "general inspection", "expect": "ex-general"},
    {"id": "dka-d-e02", "locale": "en", "query": "auscultate the lungs", "expect": "ex-chest"},
    {"id": "dka-d-e03", "locale": "en", "itemId": "thyroid", "expect": "ex-thyroid-neck"},
    {"id": "dka-d-e04", "locale": "zh-CN", "query": "神经系统查体", "expect": "ex-neuro"},
    {"id": "dka-d-e05", "locale": "zh-CN", "query": "看看皮肤有没有感染", "expect": "ex-skin"}
  ],
  "orders": [
    {"id": "dka-d-o01", "locale": "en", "query": "finger-prick glucose", "expect": "poc-glucose"},
    {"id": "dka-d-o02", "locale": "en", "itemId": "fbc", "expect": "cbc"},
    {"id": "dka-d-o03", "locale": "en", "query": "urine dip", "expect": "urinalysis"},
    {"id": "dka-d-o04", "locale": "en", "query": "TSH", "expect": null},
    {"id": "dka-d-o05", "locale": "zh-CN", "query": "查12导联心电图", "expect": "ecg"},
    {"id": "dka-d-o06", "locale": "zh-CN", "query": "查糖化血红蛋白", "expect": "hba1c"}
  ],
  "interventions": [
    {"id": "dka-d-i01", "locale": "en", "query": "balanced crystalloid 1 L over an hour", "expect": "balanced-1l-1h"},
    {"id": "dka-d-i02", "locale": "en", "itemId": "kcl", "expect": "kcl-replacement"},
    {"id": "dka-d-i03", "locale": "en", "query": "8.4% bicarbonate", "expect": "sodium-bicarbonate"},
    {"id": "dka-d-i04", "locale": "en", "query": "give IV labetalol", "expect": null},
    {"id": "dka-d-i05", "locale": "zh-CN", "query": "开始10%葡萄糖", "expect": "dextrose-10"},
    {"id": "dka-d-i06", "locale": "zh-CN", "query": "收入内科病房", "expect": "ward-admission"}
  ],
  "verifier": [
    {"id": "dka-d-v01", "locale": "en", "question": "When did this start?", "used": ["hx-onset-course"], "reply": "The day before yesterday in the afternoon — feeling sick, then vomiting and some diarrhoea.", "expect": "pass"},
    {"id": "dka-d-v02", "locale": "en", "question": "When did this start?", "used": ["hx-onset-course"], "reply": "About a week ago, after a takeaway curry.", "expect": "block", "kind": "claim"},
    {"id": "dka-d-v03", "locale": "en", "question": "When did you last change your set?", "used": ["hx-infusion-set"], "reply": "Four days ago — I know it should be every two to three days.", "expect": "pass"},
    {"id": "dka-d-v04", "locale": "en", "question": "When did you last change your set?", "used": ["hx-infusion-set"], "reply": "Six days ago.", "expect": "block", "kind": "number"},
    {"id": "dka-d-v05", "locale": "zh-CN", "question": "以前有什么病？", "used": ["hx-pmh"], "reply": "我11岁得的1型糖尿病，三年前查出甲减。", "expect": "pass"},
    {"id": "dka-d-v06", "locale": "zh-CN", "question": "以前有什么病？", "used": ["hx-pmh"], "reply": "我11岁得的1型糖尿病，还有哮喘。", "expect": "block", "kind": "claim"},
    {"id": "dka-d-v07", "locale": "zh-CN", "question": "有没有吃过格列净？", "used": [], "reply": "没有，从来没吃过。", "expect": "block", "kind": "denial", "note": "true in the case, but the voice was not given the fact"}
  ]
}
