{
  "$schema": "../../../schemas/grounding-set.schema.json",
  "format": "clinicalcraft/grounding-set@1",
  "suite": "grounding-v1",
  "split": "dev",
  "caseId": "pulmonary-embolism-postop",
  "history": [
    {"id": "pe-d-h01", "locale": "en", "text": "How can I help?", "expect": ["h-cc"]},
    {"id": "pe-d-h02", "locale": "en", "text": "When did this start?", "expect": ["h-onset"]},
    {"id": "pe-d-h03", "locale": "en", "text": "Whereabouts does it hurt?", "expect": ["h-pain-site"]},
    {"id": "pe-d-h04", "locale": "en", "text": "Is it sharp?", "expect": ["h-pain-character"]},
    {"id": "pe-d-h05", "locale": "en", "text": "Are you breathless at rest?", "expect": ["h-dyspnoea"]},
    {"id": "pe-d-h06", "locale": "en", "text": "Have you coughed up any blood?", "expect": ["h-haemoptysis"]},
    {"id": "pe-d-h07", "locale": "en", "text": "Any fever?", "expect": ["h-fever-sputum"]},
    {"id": "pe-d-h08", "locale": "en", "text": "Have you been up and walking since surgery?", "expect": ["h-mobility"]},
    {"id": "pe-d-h09", "locale": "en", "text": "Are you still having periods?", "expect": ["h-hormones"]},
    {"id": "pe-d-h10", "locale": "en", "text": "Any allergies?", "expect": ["h-allergies"]},
    {"id": "pe-d-h11", "locale": "en", "text": "Have you opened your bowels?", "expect": ["h-gi"]},
    {"id": "pe-d-h12", "locale": "en", "text": "Do you drink?", "expect": ["h-alcohol"]},
    {"id": "pe-d-h13", "locale": "en", "text": "What stage is your cancer?", "expect": ["h-unk-stage"]},
    {"id": "pe-d-h14", "locale": "en", "text": "Have you ever had a heart scan?", "expect": ["h-unk-echo"]},
    {"id": "pe-d-h15", "locale": "en", "text": "Do you knit?", "expect": []},
    {"id": "pe-d-h16", "locale": "zh-CN", "text": "现在疼几分？", "expect": ["h-pain-severity"]},
    {"id": "pe-d-h17", "locale": "zh-CN", "text": "有没有晕倒？", "expect": ["h-syncope"]},
    {"id": "pe-d-h18", "locale": "zh-CN", "text": "心慌吗？", "expect": ["h-palpitations"]},
    {"id": "pe-d-h19", "locale": "zh-CN", "text": "小腿疼吗？", "expect": ["h-calf"]},
    {"id": "pe-d-h20", "locale": "zh-CN", "text": "昨晚打抗凝针了吗？", "expect": ["h-lmwh"]},
    {"id": "pe-d-h21", "locale": "zh-CN", "text": "有没有穿弹力袜？", "expect": ["h-stockings"]},
    {"id": "pe-d-h22", "locale": "zh-CN", "text": "以前得过血栓吗？", "expect": ["h-prior-vte"]},
    {"id": "pe-d-h23", "locale": "zh-CN", "text": "以前做过别的手术吗？", "expect": ["h-psh-other"]},
    {"id": "pe-d-h24", "locale": "zh-CN", "text": "您做什么工作？", "expect": ["h-social"]},
    {"id": "pe-d-h25", "locale": "zh-CN", "text": "最近坐过长途飞机吗？", "expect": ["h-travel"]},
    {"id": "pe-d-h26", "locale": "zh-CN", "text": "您希望我们怎么帮您？", "expect": ["h-ice-expect"]},
    {"id": "pe-d-h27", "locale": "zh-CN", "text": "您喜欢唱歌吗？", "expect": []},
    {"id": "pe-d-n01", "locale": "en", "text": "You've never had a stroke or brain bleed?", "expect": ["h-neuro-history"], "tags": ["negation"]},
    {"id": "pe-d-n02", "locale": "zh-CN", "text": "没有用过激素或者避孕药吧？", "expect": ["h-hormones"], "tags": ["negation"]}
  ],
  "exam": [
    {"id": "pe-d-e01", "locale": "en", "query": "general inspection", "expect": "ex-general"},
    {"id": "pe-d-e02", "locale": "en", "itemId": "heart-sounds", "expect": "ex-heart"},
    {"id": "pe-d-e03", "locale": "en", "query": "percuss the chest", "expect": "ex-chest-insp"},
    {"id": "pe-d-e04", "locale": "zh-CN", "query": "检查双下肢，量小腿周径", "expect": "ex-legs"},
    {"id": "pe-d-e05", "locale": "zh-CN", "query": "看看皮肤有没有瘀斑", "expect": "ex-skin"}
  ],
  "orders": [
    {"id": "pe-d-o01", "locale": "en", "query": "hs-TnT", "expect": "troponin"},
    {"id": "pe-d-o02", "locale": "en", "itemId": "ddimer", "expect": "d-dimer"},
    {"id": "pe-d-o03", "locale": "en", "query": "group and save", "expect": "group-save"},
    {"id": "pe-d-o04", "locale": "en", "query": "lipase", "expect": null},
    {"id": "pe-d-o05", "locale": "zh-CN", "query": "床旁胸片", "expect": "cxr"},
    {"id": "pe-d-o06", "locale": "zh-CN", "query": "查血培养", "expect": "blood-cultures"},
    {"id": "pe-d-n06", "locale": "zh-CN", "query": "双下肢静脉超声排除深静脉血栓", "expect": "cus-legs", "tags": ["negation"]}
  ],
  "interventions": [
    {"id": "pe-d-i01", "locale": "en", "query": "enoxaparin 1 mg/kg twice daily", "expect": "lmwh-treatment"},
    {"id": "pe-d-i02", "locale": "en", "itemId": "nasal-o2", "expect": "o2-nasal"},
    {"id": "pe-d-i03", "locale": "en", "query": "IV morphine 2 mg", "expect": "morphine"},
    {"id": "pe-d-i04", "locale": "en", "query": "start warfarin", "expect": null},
    {"id": "pe-d-i05", "locale": "zh-CN", "query": "转HDU", "expect": "transfer-hdu"},
    {"id": "pe-d-i06", "locale": "zh-CN", "query": "阿替普酶溶栓", "expect": "alteplase"},
    {"id": "pe-d-n03", "locale": "en", "query": "do not give alteplase", "expect": null, "tags": ["negation"]},
    {"id": "pe-d-n04", "locale": "zh-CN", "query": "暂停肝素泵", "expect": null, "tags": ["negation"]},
    {"id": "pe-d-n05", "locale": "en", "query": "no morphine for now", "expect": null, "tags": ["negation"]}
  ],
  "verifier": [
    {"id": "pe-d-v01", "locale": "en", "question": "Have you been wearing stockings?", "used": ["h-stockings"], "reply": "They put tight stockings on before the operation, but I took them off on the second day.", "expect": "pass"},
    {"id": "pe-d-v02", "locale": "en", "question": "Have you been wearing stockings?", "used": ["h-stockings"], "reply": "Yes, I've had them on the whole time, and the leg pumps too.", "expect": "block", "kind": "claim"},
    {"id": "pe-d-v03", "locale": "zh-CN", "question": "过敏吗？", "used": ["h-allergies"], "reply": "没有已知的过敏，上个月打造影剂也没反应。", "expect": "pass"},
    {"id": "pe-d-v04", "locale": "zh-CN", "question": "过敏吗？", "used": ["h-allergies"], "reply": "我对青霉素过敏，打了会起疹子。", "expect": "block", "kind": "drug"},
    {"id": "pe-d-v05", "locale": "en", "question": "Do you have diabetes?", "used": [], "reply": "No, I don't have diabetes.", "expect": "block", "kind": "denial", "note": "true in the case, but the voice was not given the fact"},
    {"id": "pe-d-v06", "locale": "zh-CN", "question": "什么时候开始痛的？", "used": ["h-onset"], "reply": "二十分钟前，大概四点，从厕所走回来的路上突然痛的。", "expect": "pass"},
    {"id": "pe-d-n07", "locale": "en", "question": "Do you have palpitations?", "used": ["h-palpitations"], "reply": "No, my heart feels normal.", "expect": "block", "kind": "negation", "tags": ["negation"]},
    {"id": "pe-d-n08", "locale": "zh-CN", "question": "以前中过风吗？", "used": ["h-neuro-history"], "reply": "中过一次风，好几年前了。", "expect": "block", "kind": "negation", "tags": ["negation"]},
    {"id": "pe-d-n09", "locale": "en", "question": "Any long journeys recently?", "used": ["h-travel"], "reply": "No, I haven't been anywhere.", "expect": "pass", "tags": ["negation"]},
    {"id": "pe-d-n10", "locale": "zh-CN", "question": "用过激素或避孕药吗？", "used": ["h-hormones"], "reply": "从来没用过激素，也没吃过避孕药。", "expect": "pass", "tags": ["negation"]}
  ]
}
