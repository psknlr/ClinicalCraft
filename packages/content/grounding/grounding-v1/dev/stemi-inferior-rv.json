{
  "$schema": "../../../schemas/grounding-set.schema.json",
  "format": "clinicalcraft/grounding-set@1",
  "suite": "grounding-v1",
  "split": "dev",
  "caseId": "stemi-inferior-rv",
  "history": [
    {"id": "stm-d-h01", "locale": "en", "text": "Can you show me where it hurts?", "expect": ["pain-site"]},
    {"id": "stm-d-h02", "locale": "en", "text": "Whereabouts in your chest is the discomfort?", "expect": ["pain-site"]},
    {"id": "stm-d-h03", "locale": "en", "text": "When did this all begin?", "expect": ["hpi-onset"]},
    {"id": "stm-d-h04", "locale": "en", "text": "How long ago did the chest pain come on?", "expect": ["hpi-onset"]},
    {"id": "stm-d-h05", "locale": "en", "text": "Could you describe the pain for me?", "expect": ["pain-character"]},
    {"id": "stm-d-h06", "locale": "en", "text": "Is it more of a pressure or a sharp feeling?", "expect": ["pain-character"]},
    {"id": "stm-d-h07", "locale": "en", "text": "Does the pain travel to your arm or jaw?", "expect": ["pain-radiation"]},
    {"id": "stm-d-h08", "locale": "en", "text": "On a scale of one to ten, how would you rate it?", "expect": ["pain-severity"]},
    {"id": "stm-d-h09", "locale": "en", "text": "Has the pain been there continuously since it started?", "expect": ["pain-course"]},
    {"id": "stm-d-h10", "locale": "en", "text": "Does it get worse when you take a deep breath?", "expect": ["pain-pleuritic"]},
    {"id": "stm-d-h11", "locale": "en", "text": "Have you been feeling clammy or sweaty?", "expect": ["assoc-sweating"]},
    {"id": "stm-d-h12", "locale": "en", "text": "Do you feel like you might be sick?", "expect": ["assoc-nausea"]},
    {"id": "stm-d-h13", "locale": "en", "text": "Are you having any difficulty catching your breath?", "expect": ["assoc-dyspnoea"]},
    {"id": "stm-d-h14", "locale": "en", "text": "Have you felt faint at all?", "expect": ["assoc-presyncope"]},
    {"id": "stm-d-h15", "locale": "en", "text": "Has your heart been racing?", "expect": ["palpitations"]},
    {"id": "stm-d-h16", "locale": "en", "text": "Have you ever had pain like this in the past?", "expect": ["prodrome"]},
    {"id": "stm-d-h17", "locale": "en", "text": "Does it feel like something is tearing inside?", "expect": ["dissection-screen"]},
    {"id": "stm-d-h18", "locale": "en", "text": "Any swelling in your legs recently?", "expect": ["pe-screen"]},
    {"id": "stm-d-h19", "locale": "en", "text": "Have you had a temperature or been unwell lately?", "expect": ["infection-screen"]},
    {"id": "stm-d-h20", "locale": "en", "text": "Do you have any drug allergies?", "expect": ["allergies"]},
    {"id": "stm-d-h21", "locale": "en", "text": "What tablets are you on at the moment?", "expect": ["medications"]},
    {"id": "stm-d-h22", "locale": "en", "text": "Do you take any regular medication?", "expect": ["medications"]},
    {"id": "stm-d-h23", "locale": "en", "text": "What's your occupation?", "expect": ["social-living"]},
    {"id": "stm-d-h24", "locale": "en", "text": "Is there any heart disease in the family?", "expect": ["family"]},
    {"id": "stm-d-h25", "locale": "en", "text": "Have you got raised blood pressure?", "expect": ["pmh-htn"]},
    {"id": "stm-d-h26", "locale": "en", "text": "Has a doctor ever said your cholesterol is high?", "expect": ["pmh-lipids"]},
    {"id": "stm-d-h27", "locale": "en", "text": "Are you diabetic?", "expect": ["pmh-diabetes"]},
    {"id": "stm-d-h28", "locale": "en", "text": "Have you had a heart attack before?", "expect": ["pmh-cardiac"]},
    {"id": "stm-d-h29", "locale": "en", "text": "Any other health problems I should know about?", "expect": ["pmh-other"]},
    {"id": "stm-d-h30", "locale": "en", "text": "Have you ever had a stroke or any bleeding issues?", "expect": ["bleeding-history"]},
    {"id": "stm-d-h31", "locale": "en", "text": "Have you had any surgery in the past?", "expect": ["psh"]},
    {"id": "stm-d-h32", "locale": "en", "text": "When was the last time you ate?", "expect": ["last-meal"]},
    {"id": "stm-d-h33", "locale": "en", "text": "Are you a smoker?", "expect": ["smoking"]},
    {"id": "stm-d-h34", "locale": "en", "text": "How much alcohol do you drink in a week?", "expect": ["alcohol"]},
    {"id": "stm-d-h35", "locale": "en", "text": "What's worrying you most about this?", "expect": ["ice-concerns"]},
    {"id": "stm-d-h36", "locale": "en", "text": "How heavy are you?", "expect": ["weight"]},
    {"id": "stm-d-h37", "locale": "en", "text": "Have you travelled abroad recently?", "expect": ["pe-screen"]},
    {"id": "stm-d-h38", "locale": "en", "text": "Do you have a dog?", "expect": []},
    {"id": "stm-d-h39", "locale": "en", "text": "Have you had your appendix out?", "expect": ["psh"]},
    {"id": "stm-d-h40", "locale": "en", "text": "Any recent cold or flu?", "expect": ["infection-screen"]},
    {"id": "stm-d-h41", "locale": "zh-CN", "text": "痛在哪个位置？", "expect": ["pain-site"]},
    {"id": "stm-d-h42", "locale": "zh-CN", "text": "几点开始痛的？", "expect": ["hpi-onset"]},
    {"id": "stm-d-h43", "locale": "zh-CN", "text": "是压榨样的痛吗？", "expect": ["pain-character"]},
    {"id": "stm-d-h44", "locale": "zh-CN", "text": "痛会不会往胳膊或者下巴走？", "expect": ["pain-radiation"]},
    {"id": "stm-d-h45", "locale": "zh-CN", "text": "有多痛？", "expect": ["pain-severity"]},
    {"id": "stm-d-h46", "locale": "zh-CN", "text": "有没有出汗？", "expect": ["assoc-sweating"]},
    {"id": "stm-d-h47", "locale": "zh-CN", "text": "想不想吐？", "expect": ["assoc-nausea"]},
    {"id": "stm-d-h48", "locale": "zh-CN", "text": "喘不喘？", "expect": ["assoc-dyspnoea"]},
    {"id": "stm-d-h49", "locale": "zh-CN", "text": "有没有心慌？", "expect": ["palpitations"]},
    {"id": "stm-d-h50", "locale": "zh-CN", "text": "对什么药过敏吗？", "expect": ["allergies"]},
    {"id": "stm-d-h51", "locale": "zh-CN", "text": "平时吃什么药？", "expect": ["medications"]},
    {"id": "stm-d-h52", "locale": "zh-CN", "text": "家里人有心脏病吗？", "expect": ["family"]},
    {"id": "stm-d-h53", "locale": "zh-CN", "text": "血压高吗？", "expect": ["pmh-htn"]},
    {"id": "stm-d-h54", "locale": "zh-CN", "text": "有糖尿病吗？", "expect": ["pmh-diabetes"]},
    {"id": "stm-d-h55", "locale": "zh-CN", "text": "抽烟吗？", "expect": ["smoking"]},
    {"id": "stm-d-h56", "locale": "zh-CN", "text": "喝酒吗？", "expect": ["alcohol"]},
    {"id": "stm-d-h57", "locale": "zh-CN", "text": "做过手术吗？", "expect": ["psh"]},
    {"id": "stm-d-h58", "locale": "zh-CN", "text": "最后一次吃饭是什么时候？", "expect": ["last-meal"]},
    {"id": "stm-d-h59", "locale": "zh-CN", "text": "你最担心的是什么？", "expect": ["ice-concerns"]},
    {"id": "stm-d-h60", "locale": "zh-CN", "text": "你家养狗吗？", "expect": []},
    {"id": "stm-d-n01", "locale": "en", "text": "The pain isn't tearing through to your back?", "expect": ["dissection-screen"], "tags": ["negation"]},
    {"id": "stm-d-n02", "locale": "zh-CN", "text": "以前心脏没出过问题吧？", "expect": ["pmh-cardiac"], "tags": ["negation"]}
  ],
  "exam": [
    {"id": "stm-d-e01", "locale": "en", "query": "general inspection", "expect": "general"},
    {"id": "stm-d-e02", "locale": "en", "itemId": "radial", "expect": "radial-pulse"},
    {"id": "stm-d-e03", "locale": "en", "query": "examine his legs", "expect": "legs"},
    {"id": "stm-d-e04", "locale": "zh-CN", "query": "摸摸肚子", "expect": "abdomen"},
    {"id": "stm-d-e05", "locale": "zh-CN", "query": "简单查一下神经系统", "expect": "neuro"}
  ],
  "orders": [
    {"id": "stm-d-o01", "locale": "en", "query": "12-lead ECG", "expect": "ecg-12lead"},
    {"id": "stm-d-o02", "locale": "en", "itemId": "ck", "expect": "ck-mb"},
    {"id": "stm-d-o03", "locale": "en", "query": "chest x-ray", "expect": "cxr-portable"},
    {"id": "stm-d-o04", "locale": "en", "query": "CT coronary angiogram", "expect": null},
    {"id": "stm-d-o05", "locale": "en", "query": "D-dimer", "expect": "d-dimer"},
    {"id": "stm-d-o06", "locale": "zh-CN", "query": "查BNP", "expect": "nt-probnp"},
    {"id": "stm-d-n06", "locale": "en", "query": "right-sided leads to rule out RV infarction", "expect": "ecg-right-sided", "tags": ["negation"]}
  ],
  "interventions": [
    {"id": "stm-d-i01", "locale": "en", "query": "GTN spray", "expect": "nitroglycerin"},
    {"id": "stm-d-i02", "locale": "en", "itemId": "clopidogrel-600", "expect": "clopidogrel"},
    {"id": "stm-d-i03", "locale": "en", "query": "morphine 2.5 mg IV", "expect": "morphine"},
    {"id": "stm-d-i04", "locale": "en", "query": "thrombolyse with alteplase", "expect": null},
    {"id": "stm-d-i05", "locale": "zh-CN", "query": "阿托品0.5 mg静推", "expect": "atropine"},
    {"id": "stm-d-i06", "locale": "zh-CN", "query": "转运去导管室", "expect": "transfer-cath-lab"},
    {"id": "stm-d-n03", "locale": "en", "query": "don't give GTN", "expect": null, "tags": ["negation"]},
    {"id": "stm-d-n04", "locale": "zh-CN", "query": "不要给吗啡", "expect": null, "tags": ["negation"]},
    {"id": "stm-d-n05", "locale": "en", "query": "no fibrinolysis", "expect": null, "tags": ["negation"]}
  ],
  "verifier": [
    {"id": "stm-d-v01", "locale": "en", "question": "Have you had this pain before?", "used": ["prodrome"], "reply": "Never this bad, but for a couple of weeks my chest got tight on the stairs and settled after a few minutes' rest.", "expect": "pass"},
    {"id": "stm-d-v02", "locale": "en", "question": "Have you had this pain before?", "used": ["prodrome"], "reply": "Yes, I had the same pain last month and went to A&E.", "expect": "block", "kind": "claim"},
    {"id": "stm-d-v03", "locale": "zh-CN", "question": "最后一次吃东西是什么时候？", "used": ["last-meal"], "reply": "早上七点吃的早饭，一碗粥两个包子。", "expect": "pass"},
    {"id": "stm-d-v04", "locale": "zh-CN", "question": "最后一次吃东西是什么时候？", "used": ["last-meal"], "reply": "早上九点吃的，吃了一碗面条。", "expect": "block", "kind": "number"},
    {"id": "stm-d-v05", "locale": "en", "question": "Any lung problems?", "used": [], "reply": "No, my lungs are fine.", "expect": "block", "kind": "denial"},
    {"id": "stm-d-n07", "locale": "en", "question": "Have you been sweating?", "used": ["assoc-sweating"], "reply": "No, I haven't been sweating at all.", "expect": "block", "kind": "negation", "tags": ["negation"]},
    {"id": "stm-d-n08", "locale": "zh-CN", "question": "有没有心脏病史？", "used": ["pmh-cardiac"], "reply": "有，前几年放过一个支架。", "expect": "block", "kind": "negation", "tags": ["negation"]},
    {"id": "stm-d-n09", "locale": "en", "question": "Is the pain tearing, going through to your back?", "used": ["dissection-screen"], "reply": "No, it's pressing, not tearing — and my back doesn't hurt.", "expect": "pass", "tags": ["negation"]},
    {"id": "stm-d-n10", "locale": "zh-CN", "question": "心慌吗？", "used": ["palpitations"], "reply": "不心慌，心跳也不乱。", "expect": "pass", "tags": ["negation"]}
  ]
}
