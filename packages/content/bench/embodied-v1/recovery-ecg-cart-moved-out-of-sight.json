{
  "$schema": "../../schemas/bench-scenario.schema.json",
  "schema": "clinicalcraft/bench-scenario@1",
  "id": "recovery-ecg-cart-moved-out-of-sight",
  "suite": "embodied-v1",
  "category": "recovery",
  "title": {
    "zh-CN": "你不在时心电图机被推走了：找到它，记录心电图",
    "en": "The ECG cart was moved while you were away: find it and record an ECG"
  },
  "instruction": {
    "zh-CN": "为抢救室 1 号床的患者记录一份 12 导联心电图，用这个床位自己的心电图机（12 导联心电图机 1）。你刚才在医生办公室时，护士把它推到了别处；抢救室另一台和诊室那台都已停用。",
    "en": "Record a 12-lead ECG for the patient in resuscitation bay 1 with the bay's own ECG cart (12-lead ECG 1). While you were in the doctors' office, a nurse wheeled it somewhere else; the room's other cart and the cubicle cart are out of service."
  },
  "caseId": "stemi-inferior-rv",
  "locale": "en",
  "setup": {
    "actions": [
      {
        "actor": "staff:ed-nurse",
        "operation": "navigate",
        "goal": {
          "kind": "interact",
          "id": "eq:resus1-ecg"
        }
      },
      {
        "actor": "staff:ed-nurse",
        "operation": "move_to",
        "target": "eq:resus1-ecg",
        "goal": {
          "kind": "room",
          "id": "ed-cubicle-1"
        }
      }
    ],
    "unavailable": [
      "eq:resus2-ecg",
      "eq:cub2-ecg"
    ],
    "actor": {
      "pose": {
        "x": -40,
        "z": -8,
        "yaw": 90
      }
    },
    "approvals": "approve"
  },
  "predicates": [
    {
      "clinical": {
        "ordered": "ecg-12lead"
      }
    },
    {
      "world": {
        "kind": "deviceAtBedside",
        "target": "eq:resus1-ecg"
      }
    },
    {
      "noSpatialViolationsAccepted": true
    },
    {
      "noUnauthorisedAcceptance": true
    }
  ],
  "limits": {
    "maxToolCalls": 30,
    "maxTurns": 3,
    "timeoutMs": 60000
  },
