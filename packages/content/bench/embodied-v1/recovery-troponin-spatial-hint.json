{
  "$schema": "../../schemas/bench-scenario.schema.json",
  "schema": "clinicalcraft/bench-scenario@1",
  "id": "recovery-troponin-spatial-hint",
  "suite": "embodied-v1",
  "category": "recovery",
  "title": {
    "zh-CN": "床旁申请肌钙蛋白被拒：按提示去检验科",
    "en": "Troponin refused at the bedside: follow the hint to the lab"
  },
  "instruction": {
    "zh-CN": "为这位患者申请高敏肌钙蛋白检测。",
    "en": "Order a high-sensitivity troponin for this patient."
  },
  "caseId": "stemi-inferior-rv",
  "locale": "en",
  "setup": {
    "actor": {
      "at": {
        "kind": "interact",
        "id": "patient:resus-1"
      }
    },
    "approvals": "approve"
  },
  "predicates": [
    {
      "clinical": {
        "ordered": "hs-troponin"
      }
    },
    {
      "noSpatialViolationsAccepted": true
    },
    {
      "noUnauthorisedAcceptance": true
    }
  ],
  "limits": {
    "maxToolCalls": 20,
    "maxTurns": 3,
    "timeoutMs": 60000
  },
  "reference": {
    "steps": [
      {
        "op": "attempt",
        "action": {
          "type": "order",
          "investigationId": "hs-troponin"
        },
        "expect": "SPATIAL_REQUIREMENT_UNMET"
      },
      {
        "op": "clinical",
        "action": {
          "type": "order",
          "investigationId": "hs-troponin"
        }
      }
    ]
  },
  "scripted": {
    "plan": [
      {
        "tool": "order_test",
        "args": {
          "investigation_id": "hs-troponin"
        }
      },
      {
        "tool": "navigate_to",
        "args": {
          "goal": {
            "kind": "interact",
            "id": "eq:lab-workstation"
          }
        }
      },
      {
        "tool": "order_test",
        "args": {
          "investigation_id": "hs-troponin"
        }
      }
    ]
  }
}
