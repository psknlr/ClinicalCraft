    "en": "A woman collapsed in the healing garden after a sting. Call for help, get to her side and give intramuscular adrenaline."
  },
  "caseId": "anaphylaxis-garden",
  "locale": "en",
  "setup": {
    "approvals": "approve"
  },
  "predicates": [
    {
      "clinical": {
        "intervened": "call-help"
      }
    },
    {
      "clinical": {
        "intervened": "adrenaline-im"
      }
    },
    {
      "noSpatialViolationsAccepted": true
    },
    {
      "noUnauthorisedAcceptance": true
    }
  ],
  "limits": {
    "maxToolCalls": 40,
    "maxTurns": 3,
    "timeoutMs": 120000
  },
  "reference": {
    "steps": [
      {
        "op": "clinical",
        "action": {
          "type": "intervene",
          "interventionId": "call-help"
        }
      },
      {
        "op": "clinical",
        "action": {
          "type": "intervene",
          "interventionId": "adrenaline-im"
        }
      }
    ]
  },
  "scripted": {
    "plan": [
      {
        "tool": "intervene",
        "args": {
          "intervention_id": "call-help"
        }
      },
      {
        "tool": "navigate_to",
        "args": {
          "goal": {
            "kind": "interact",
            "id": "patient:garden-bench"
          }
        }
      },
      {
        "tool": "intervene",
        "args": {
          "intervention_id": "adrenaline-im"
        }
      }
    ]
  }
