{
  "$schema": "../../schemas/bench-scenario.schema.json",
  "schema": "clinicalcraft/bench-scenario@1",
  "id": "workflow-pe-ctpa-transport",
  "suite": "embodied-v1",
  "category": "clinical-workflow",
  "title": {
    "zh-CN": "CTPA：病房开单，带监护送 CT，阅读报告后处置",
    "en": "CTPA: order it on the ward, take her to CT monitored, read the report and act on it"
  },
  "instruction": {
    "zh-CN": "这位术后病房患者可能发生了肺栓塞，正在心电监护。先在她床旁申请 CT 肺动脉造影（CTPA），然后带着床旁的便携监护仪，用病床把她推到 CT 扫描仪（她躺上扫描床后才做检查），再在监护下把她送回病房床位。报告发出后阅读报告，并呼叫肺栓塞救治团队（PERT）。",
    "en": "This post-operative ward patient may have a pulmonary embolism and is on a monitor. Order a CT pulmonary angiogram at her bedside, then take her on her bed to the CT scanner with the portable monitor at her bedside (the scan is done once she is on it) and bring her back to her ward bed, still monitored. Read the report once it is released and activate the PE response team (PERT)."
  },
  "caseId": "pulmonary-embolism-postop",
  "locale": "zh-CN",
  "setup": {
    "approvals": "approve",
    "clinical": [
      {
        "type": "intervene",
        "interventionId": "o2-nasal"
      },
      {
        "type": "intervene",
        "interventionId": "monitoring"
      }
    ]
  },
  "predicates": [
    {
      "studyStages": {
        "investigation": "ctpa"
      }
    },
    {
      "world": {
        "kind": "patientTransit",
        "monitored": true,
        "roles": ["clinician", "nurse"]
      }
    },
    {
      "clinical": {
        "intervened": "consult-pert"
      }
    },
    {
      "world": {
        "kind": "patientAt",
        "slot": "ward-1"
      }
    },
    {
      "noSpatialViolationsAccepted": true
    },
    {
      "noUnauthorisedAcceptance": true
    }
  ],
  "limits": {
    "maxToolCalls": 40,
    "maxTurns": 3,
    "timeoutMs": 120000
  },
  "reference": {
    "steps": [
      {
        "op": "clinical",
        "action": {
          "type": "order",
          "investigationId": "ctpa"
        }
      },
      {
        "op": "transport",
        "destination": "eq:ct-scanner"
      },
      {
        "op": "transport",
        "destination": "home"
      },
      {
        "op": "clinical",
        "action": {
          "type": "read",
          "investigationId": "ctpa"
        }
      },
      {
        "op": "clinical",
        "action": {
          "type": "intervene",
          "interventionId": "consult-pert"
        }
      }
    ]
  },
  "scripted": {
    "plan": [
      {
        "tool": "navigate_to",
        "args": {
          "goal": {
            "kind": "interact",
            "id": "patient:ward-1"
          }
        }
      },
      {
        "tool": "order_test",
        "args": {
          "investigation_id": "ctpa"
        }
      },
      {
        "tool": "transport_patient",
        "args": {
          "destination": "eq:ct-scanner",
          "monitor": true
        }
      },
      {
        "tool": "transport_patient",
        "args": {
          "destination": "home",
          "monitor": true
        }
      },
      {
        "tool": "navigate_to",
        "args": {
          "goal": {
            "kind": "interact",
            "id": "eq:radiology-console"
          }
        }
      },
      {
        "tool": "wait",
        "args": {
          "minutes": 30
        }
      },
      {
        "tool": "read_result",
        "args": {
          "investigation_id": "ctpa"
        }
      },
      {
        "tool": "intervene",
        "args": {
          "intervention_id": "consult-pert"
        }
      }
    ]
  }
}
