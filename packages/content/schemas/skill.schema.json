{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClinicalCraft skill (clinicalcraft/skill@1)",
  "description": "An embodied-mode skill (.clinicalcraft/skills/*.json): typed parameters, safety class, preconditions, steps (tool calls with ${param} / ${steps.<id>.data.<path>} templates, when, retry, onError), postconditions and recovery strategies. Data, never code.",
  "$ref": "#/definitions/Skill",
  "definitions": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "LocalizedText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          }
        }
      ]
    },
    "SkillPredicate": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "clinical": {}
          },
          "required": [
            "clinical"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "actorNear": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "range": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "actorNear",
            "range"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "entityState": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "state": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "minItems": 1,
                  "maxItems": 8
                }
              ]
            }
          },
          "required": [
            "entityState",
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "world": {},
            "target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "world"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/SkillPredicate"
              },
              "maxItems": 16
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/SkillPredicate"
              },
              "maxItems": 16
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/definitions/SkillPredicate"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JsonValue"
          },
          "maxItems": 32
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/JsonValue"
          },
          "propertyNames": {
            "maxLength": 80
          }
        }
      ]
    },
    "Skill": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schema": {
          "type": "string",
          "const": "clinicalcraft/skill@1"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "propertyNames": {
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
              }
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "propertyNames": {
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
              }
            }
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "entity",
                  "investigation",
                  "intervention",
                  "finding",
                  "string",
                  "number"
                ]
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    },
                    "propertyNames": {
                      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
                    }
                  }
                ]
              },
              "required": {
                "type": "boolean"
              },
              "default": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 200
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "propertyNames": {
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "safety": {
          "type": "string",
          "enum": [
            "read-only",
            "physical",
            "clinical",
            "high-risk"
          ]
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SkillPredicate"
          },
          "maxItems": 16
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "tool": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,59}$"
              },
              "args": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/definitions/JsonValue"
                },
                "propertyNames": {
                  "maxLength": 80
                }
              },
              "when": {
                "$ref": "#/definitions/SkillPredicate"
              },
              "retry": {
                "type": "object",
                "properties": {
                  "attempts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "on": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "minItems": 1,
                    "maxItems": 16
                  }
                },
                "required": [
                  "attempts",
                  "on"
                ],
                "additionalProperties": false
              },
              "onError": {
                "type": "string",
                "enum": [
                  "abort",
                  "continue"
                ]
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    },
                    "propertyNames": {
                      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
                    }
                  }
                ]
              }
            },
            "required": [
              "id",
              "tool"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 32
        },
        "postconditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SkillPredicate"
          },
          "maxItems": 16
        },
        "recovery": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "minItems": 1,
                "maxItems": 16
              },
              "strategy": {
                "type": "string",
                "enum": [
                  "replan",
                  "alternate-provider",
                  "fetch-equipment"
                ]
              }
            },
            "required": [
              "on",
              "strategy"
            ],
            "additionalProperties": false
          },
          "maxItems": 8
        }
      },
      "required": [
        "schema",
        "id",
        "name",
        "description",
        "safety",
        "steps"
      ],
      "additionalProperties": false
    }
  }
}
