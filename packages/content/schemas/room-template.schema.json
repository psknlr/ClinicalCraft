{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClinicalCraft room template (clinicalcraft/room-template@1)",
  "description": "A reusable room placed by facility `instances` and compiled into the flat facility format: size, kind, partitions, sign, lights, equipment, patient slots, staff and interaction zones in template-local coordinates.",
  "$ref": "#/definitions/RoomTemplate",
  "definitions": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "LocalizedText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          }
        }
      ]
    },
    "Capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "HexColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "Rect": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "d": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "z",
        "w",
        "d"
      ],
      "additionalProperties": false
    },
    "Opening": {
      "type": "object",
      "properties": {
        "side": {
          "type": "string",
          "enum": [
            "n",
            "s",
            "e",
            "w"
          ]
        },
        "offset": {
          "type": "number",
          "default": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 3
        },
        "kind": {
          "type": "string",
          "enum": [
            "opening",
            "door",
            "double-door",
            "sliding-door",
            "window"
          ],
          "default": "opening"
        },
        "sill": {
          "type": "number",
          "minimum": 0,
          "default": 1
        },
        "levels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Id"
          },
          "minItems": 1
        }
      },
      "required": [
        "side"
      ],
      "additionalProperties": false
    },
    "VoxelPart": {
      "type": "object",
      "properties": {
        "m": {
          "$ref": "#/definitions/Id"
        },
        "p": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ]
        },
        "s": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ]
        },
        "r": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "anim": {
          "type": "string",
          "enum": [
            "none",
            "blink",
            "spin",
            "pulse",
            "slide"
          ],
          "default": "none"
        }
      },
      "required": [
        "m",
        "p",
        "s"
      ],
      "additionalProperties": false
    },
    "RoomTemplate": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "clinicalcraft/room-template@1"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "$ref": "#/definitions/LocalizedText"
        },
        "description": {
          "$ref": "#/definitions/LocalizedText"
        },
        "kind": {
          "type": "string",
          "enum": [
            "entrance",
            "reception",
            "waiting",
            "consult",
            "triage",
            "resus",
            "emergency",
            "ward",
            "icu",
            "operating-room",
            "imaging",
            "laboratory",
            "pathology",
            "pharmacy",
            "nurse-station",
            "conference",
            "office",
            "corridor",
            "storage",
            "restroom",
            "garden",
            "build-zone",
            "rehabilitation",
            "teaching",
            "elevator",
            "stairwell"
          ]
        },
        "size": {
          "type": "object",
          "properties": {
            "w": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "d": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "w",
            "d"
          ],
          "additionalProperties": false
        },
        "floor": {
          "$ref": "#/definitions/Id"
        },
        "partitions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "side": {
                "type": "string",
                "enum": [
                  "n",
                  "s",
                  "e",
                  "w"
                ]
              },
              "material": {
                "$ref": "#/definitions/Id",
                "default": "white"
              },
              "base": {
                "$ref": "#/definitions/Id",
                "default": "teal"
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "default": 4
              },
              "thickness": {
                "type": "number",
                "exclusiveMinimum": 0,
                "default": 0.35
              },
              "openings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "offset": {
                      "type": "number",
                      "default": 0
                    },
                    "width": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "default": 2
                    },
                    "height": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "default": 3
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "opening",
                        "door",
                        "double-door",
                        "sliding-door",
                        "window"
                      ],
                      "default": "opening"
                    },
                    "sill": {
                      "type": "number",
                      "minimum": 0,
                      "default": 1
                    }
                  },
                  "additionalProperties": false
                },
                "default": []
              }
            },
            "required": [
              "side"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "sign": {
          "type": "object",
          "properties": {
            "text": {
              "$ref": "#/definitions/LocalizedText"
            },
            "color": {
              "$ref": "#/definitions/HexColor"
            },
            "side": {
              "type": "string",
              "enum": [
                "n",
                "s",
                "e",
                "w"
              ]
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "lights": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "z"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "placements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/Id"
              },
              "type": {
                "$ref": "#/definitions/Id"
              },
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              },
              "y": {
                "type": "number",
                "default": 0
              },
              "rot": {
                "type": "number",
                "default": 0
              },
              "label": {
                "$ref": "#/definitions/LocalizedText"
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/Capability"
                }
              },
              "extraParts": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/VoxelPart"
                }
              },
              "hideParts": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "required": [
              "id",
              "type",
              "x",
              "z"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "patientSlots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/Id"
              },
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              },
              "rot": {
                "type": "number",
                "default": 0
              },
              "posture": {
                "type": "string",
                "enum": [
                  "standing",
                  "sitting",
                  "lying"
                ],
                "default": "standing"
              },
              "bed": {
                "$ref": "#/definitions/Id"
              },
              "accepts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "outpatient",
                    "emergency",
                    "inpatient",
                    "icu",
                    "ward",
                    "operating-room",
                    "community"
                  ]
                },
                "minItems": 1
              },
              "monitor": {
                "$ref": "#/definitions/Id"
              }
            },
            "required": [
              "id",
              "x",
              "z",
              "accepts"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "staff": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/Id"
              },
              "role": {
                "type": "string",
                "enum": [
                  "nurse",
                  "radiologist",
                  "pathologist",
                  "lab-tech",
                  "attending",
                  "pharmacist",
                  "receptionist",
                  "paramedic",
                  "porter"
                ]
              },
              "name": {
                "$ref": "#/definitions/LocalizedText"
              },
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              },
              "rot": {
                "type": "number",
                "default": 0
              },
              "appearance": {
                "type": "object",
                "properties": {
                  "skin": {
                    "$ref": "#/definitions/HexColor",
                    "default": "#cba88a"
                  },
                  "hair": {
                    "$ref": "#/definitions/HexColor",
                    "default": "#3b3027"
                  },
                  "hairStyle": {
                    "type": "string",
                    "enum": [
                      "short",
                      "long",
                      "bald",
                      "bun",
                      "ponytail",
                      "curly"
                    ],
                    "default": "short"
                  },
                  "shirt": {
                    "$ref": "#/definitions/HexColor",
                    "default": "#6d9fba"
                  },
                  "pants": {
                    "$ref": "#/definitions/HexColor",
                    "default": "#354442"
                  },
                  "build": {
                    "type": "string",
                    "enum": [
                      "slim",
                      "average",
                      "heavy"
                    ],
                    "default": "average"
                  },
                  "stature": {
                    "type": "string",
                    "enum": [
                      "infant",
                      "child",
                      "teen",
                      "adult"
                    ],
                    "default": "adult"
                  },
                  "gown": {
                    "type": "boolean",
                    "default": false
                  },
                  "accessory": {
                    "type": "string",
                    "enum": [
                      "none",
                      "glasses",
                      "mask",
                      "nasal-cannula",
                      "oxygen-mask",
                      "sling",
                      "cap"
                    ],
                    "default": "none"
                  }
                },
                "additionalProperties": false
              },
              "greeting": {
                "$ref": "#/definitions/LocalizedText"
              }
            },
            "required": [
              "id",
              "role",
              "name",
              "x",
              "z"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/Id"
              },
              "name": {
                "$ref": "#/definitions/LocalizedText"
              },
              "rect": {
                "$ref": "#/definitions/Rect"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "clinician",
                    "nurse",
                    "radiologist",
                    "pathologist",
                    "lab-tech",
                    "attending",
                    "pharmacist",
                    "receptionist",
                    "paramedic",
                    "porter"
                  ]
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "name",
              "rect",
              "roles"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Capability"
          },
          "default": []
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "schema",
        "id",
        "name",
        "kind",
        "size"
      ],
      "additionalProperties": false
    }
  }
}
