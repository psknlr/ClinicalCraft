          "required": [
            "actorHolding"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Id"
                },
                {
                  "type": "array",
