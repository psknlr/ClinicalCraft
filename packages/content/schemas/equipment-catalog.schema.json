                "type": {
                  "$ref": "#/definitions/Id"
                },
                "state": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/Id"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/Id"
                      },
                      "minItems": 1
                    }
                  ]
                },
                "within": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 20
                }
              },
              "required": [
                "type",
                "state"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "nearbyState"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/WorldPredicate"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/WorldPredicate"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/definitions/WorldPredicate"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        }
      ]
    },
