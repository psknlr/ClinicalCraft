            "actorWithin"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "patientWithin": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "patientWithin"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "deviceAtBedside": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "deviceAtBedside"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "actorHolding": {
              "type": "string",
              "minLength": 1
            }
