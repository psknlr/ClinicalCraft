                  },
                  "minItems": 1
                }
              ]
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "role": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "clinician",
                  "nurse",
                  "radiologist",
                  "pathologist",
                  "lab-tech",
                  "attending",
                  "pharmacist",
                  "receptionist",
                  "paramedic",
                  "porter"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "role"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
