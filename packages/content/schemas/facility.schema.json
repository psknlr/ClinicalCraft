{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClinicalCraft facility (clinicalcraft/facility@1)",
  "description": "A voxel clinical environment: bounds, terrain, buildings, rooms, equipment placements, patient slots, staff, build zone, levels, connectors and access zones.",
  "$ref": "#/definitions/Facility",
  "definitions": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "LocalizedText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          }
        }
      ]
    },
    "Capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "HexColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "Rect": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "d": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "z",
        "w",
        "d"
      ],
      "additionalProperties": false
    },
    "Opening": {
      "type": "object",
      "properties": {
        "side": {
          "type": "string",
          "enum": [
            "n",
            "s",
            "e",
            "w"
          ]
        },
        "offset": {
          "type": "number",
          "default": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 3
        },
        "kind": {
          "type": "string",
          "enum": [
            "opening",
            "door",
            "double-door",
            "sliding-door",
            "window"
          ],
          "default": "opening"
        },
        "sill": {
          "type": "number",
          "minimum": 0,
          "default": 1
        }
      },
      "required": [
        "side"
      ],
      "additionalProperties": false
    },
    "Material": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "color": {
          "$ref": "#/definitions/HexColor"
        },
        "pattern": {
          "type": "string",
          "enum": [
            "noise",
            "brick",
            "plank",
            "tile",
            "flat",
            "stripe",
            "grid",
            "dots",
            "screen"
          ],
          "default": "noise"
        },
        "variance": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "default": 0.11
        },
        "emissive": {
          "$ref": "#/definitions/HexColor"
        },
        "emissiveIntensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "default": 0.3
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.93
        },
        "metalness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "castShadow": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "id",
        "color"
      ],
      "additionalProperties": false
    },
    "Facility": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "clinicalcraft/facility@1"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "name": {
          "$ref": "#/definitions/LocalizedText"
        },
        "description": {
          "$ref": "#/definitions/LocalizedText"
        },
        "bounds": {
          "type": "object",
          "properties": {
            "minX": {
              "type": "number"
            },
            "maxX": {
              "type": "number"
            },
            "minZ": {
              "type": "number"
            },
            "maxZ": {
              "type": "number"
            }
          },
          "required": [
            "minX",
            "maxX",
            "minZ",
            "maxZ"
          ],
          "additionalProperties": false
        },
        "spawn": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "yaw": {
              "type": "number",
              "default": 0
            }
          },
          "required": [
            "x",
            "z"
          ],
          "additionalProperties": false
        },
        "environment": {
          "type": "object",
          "properties": {
            "sky": {
              "$ref": "#/definitions/HexColor",
              "default": "#a8d5e0"
            },
            "fog": {
              "type": "object",
              "properties": {
                "color": {
                  "$ref": "#/definitions/HexColor"
                },
                "near": {
                  "type": "number"
                },
                "far": {
                  "type": "number"
                }
              },
              "required": [
                "color",
                "near",
                "far"
              ],
              "additionalProperties": false,
              "default": {
                "color": "#b9d8d6",
                "near": 38,
                "far": 82
              }
            },
            "sunIntensity": {
              "type": "number",
              "minimum": 0,
              "default": 3.4
            },
            "hemisphere": {
              "type": "object",
              "properties": {
                "sky": {
                  "$ref": "#/definitions/HexColor"
                },
                "ground": {
                  "$ref": "#/definitions/HexColor"
                },
                "intensity": {
                  "type": "number"
                }
              },
              "required": [
                "sky",
                "ground",
                "intensity"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "catalogs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Id"
          },
          "default": [
            "core"
          ]
        },
        "materials": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Material"
          },
          "default": []
        },
        "terrain": {
          "type": "object",
          "properties": {
            "ground": {
              "$ref": "#/definitions/Id",
              "default": "grass"
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "d": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "material": {
                    "$ref": "#/definitions/Id",
                    "default": "path"
                  }
                },
                "required": [
                  "x",
                  "z",
                  "w",
                  "d"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "ponds": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Rect"
              },
              "default": []
            },
            "trees": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  },
                  "h": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 9
                  }
                },
                "required": [
                  "x",
                  "z",
                  "h"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "flowers": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 500
                },
                "seed": {
                  "type": "integer",
                  "default": 7103
                },
                "exclude": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Rect"
                  },
                  "default": []
                }
              },
              "required": [
                "count"
              ],
              "additionalProperties": false,
              "default": {
                "count": 0,
                "seed": 7103,
                "exclude": []
              }
            },
            "horizon": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 200
                },
                "radius": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "count",
                "radius"
              ],
              "additionalProperties": false
            },
            "clouds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60,
              "default": 14
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "buildings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/Id"
              },
              "name": {
                "$ref": "#/definitions/LocalizedText"
