                  },
                  "body": {
                    "$ref": "#/definitions/Id",
                    "default": "cream"
                  },
                  "top": {
                    "$ref": "#/definitions/Id",
                    "default": "wood"
                  },
                  "thickness": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "default": 1
                  }
                },
                "additionalProperties": false,
                "default": {}
              },
              "openings": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/Opening"
                },
                "default": []
              },
              "roof": {
                "type": "object",
                "properties": {
                  "material": {
                    "$ref": "#/definitions/Id",
                    "default": "roof"
                  },
                  "skylights": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/Rect"
                    },
                    "default": []
                  },
                  "beams": {
                    "$ref": "#/definitions/Id"
                  }
                },
                "additionalProperties": false,
                "default": {}
              },
              "sign": {
                "type": "object",
                "properties": {
                  "text": {
                    "$ref": "#/definitions/LocalizedText"
                  },
                  "side": {
                    "type": "string",
                    "enum": [
                      "n",
                      "s",
                      "e",
                      "w"
                    ]
                  },
                  "color": {
                    "$ref": "#/definitions/HexColor"
                  }
                },
                "required": [
                  "text",
                  "side"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "name",
              "rect"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "rooms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/Id"
