              "name": {
                "$ref": "#/definitions/LocalizedText"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "entrance",
                  "reception",
                  "waiting",
                  "consult",
                  "triage",
                  "resus",
                  "emergency",
                  "ward",
                  "icu",
                  "operating-room",
                  "imaging",
                  "laboratory",
                  "pathology",
                  "pharmacy",
                  "nurse-station",
                  "conference",
                  "office",
                  "corridor",
                  "storage",
                  "restroom",
                  "garden",
                  "build-zone"
                ]
              },
              "building": {
                "$ref": "#/definitions/Id"
              },
              "level": {
                "$ref": "#/definitions/Id"
              },
              "rect": {
                "$ref": "#/definitions/Rect"
              },
              "floor": {
                "$ref": "#/definitions/Id"
              },
              "partitions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "side": {
                      "type": "string",
                      "enum": [
                        "n",
                        "s",
                        "e",
                        "w"
                      ]
                    },
                    "material": {
                      "$ref": "#/definitions/Id",
                      "default": "white"
                    },
                    "base": {
                      "$ref": "#/definitions/Id",
                      "default": "teal"
                    },
                    "height": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "default": 4
                    },
                    "thickness": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "default": 0.35
                    },
                    "openings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "offset": {
                            "type": "number",
                            "default": 0
                          },
                          "width": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "default": 2
                          },
                          "height": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "default": 3
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "opening",
                              "door",
                              "double-door",
                              "sliding-door",
                              "window"
                            ],
                            "default": "opening"
                          },
                          "sill": {
                            "type": "number",
                            "minimum": 0,
                            "default": 1
                          }
                        },
                        "additionalProperties": false
                      },
                      "default": []
                    }
                  },
                  "required": [
                    "side"
                  ],
                  "additionalProperties": false
                },
                "default": []
              },
              "sign": {
                "type": "object",
                "properties": {
                  "text": {
                    "$ref": "#/definitions/LocalizedText"
                  },
                  "color": {
                    "$ref": "#/definitions/HexColor"
                  },
                  "side": {
                    "type": "string",
                    "enum": [
                      "n",
                      "s",
                      "e",
                      "w"
                    ]
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              },
              "lights": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "z"
                  ],
                  "additionalProperties": false
                },
                "default": []
              }
            },
            "required": [
              "id",
              "name",
              "kind",
              "rect"
            ],
            "additionalProperties": false
          },
          "default": []
