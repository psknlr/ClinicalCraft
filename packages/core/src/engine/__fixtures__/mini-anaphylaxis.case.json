      { "id": "dbp-fall", "vital": "dbp", "perMinute": -1, "min": -25, "until": { "intervened": "epi" } },
      { "id": "desat", "vital": "spo2", "perMinute": -0.5, "min": -12, "until": { "flag": "oxygen-on" } }
    ],
    "events": [
      { "id": "stridor", "atMinute": 10, "setVitals": { "rr": 30 }, "setFlags": ["stridor"], "severity": "warning",
        "message": { "en": "The patient now has loud stridor.", "zh-CN": "患者出现明显喘鸣。" } },
      { "id": "collapse", "when": { "vital": "sbp", "op": "lte", "value": 70 }, "setVitals": { "hr": 140 }, "setFlags": ["collapsed"], "severity": "critical",
        "message": { "en": "She slumps and becomes grey.", "zh-CN": "患者瘫倒，面色灰白。" } }
    ]
  },
  "objectives": [
    {
      "id": "assess",
      "title": { "en": "Assess airway and allergy history", "zh-CN": "评估气道与过敏史" },
      "hint": { "en": "Look at the airway and ask about allergies.", "zh-CN": "查看气道并询问过敏史。" },
      "completeWhen": { "all": [{ "examined": "airway" }, { "asked": "allergies" }] },
      "waypoints": [{ "unless": { "examined": "airway" }, "target": "patient" }, { "target": "records" }]
    },
    {
      "id": "treat",
      "title": { "en": "Give first-line treatment", "zh-CN": "给予一线治疗" },
      "hint": { "en": "IM adrenaline.", "zh-CN": "肌注肾上腺素。" },
      "completeWhen": { "intervened": "epi" },
      "waypoints": [{ "target": "medications" }]
    },
    {
      "id": "stabilise",
      "title": { "en": "Stabilise oxygenation", "zh-CN": "稳定氧合" },
      "hint": { "en": "Oxygen after adrenaline.", "zh-CN": "肾上腺素后吸氧。" },
      "completeWhen": { "all": [{ "flag": "oxygen-on" }, { "objective": "treat" }] }
    },
    {
      "id": "diagnose",
      "title": { "en": "Name the diagnosis", "zh-CN": "作出诊断" },
      "hint": { "en": "Food trigger + airway + shock.", "zh-CN": "食物诱因＋气道＋休克。" },
      "completeWhen": { "decided": "dx" }
    },
    {
      "id": "dispose",
      "title": { "en": "Plan disposition", "zh-CN": "制定去向" },
      "hint": { "en": "Observation and discharge planning.", "zh-CN": "观察与出院计划。" },
      "completeWhen": { "decided": "disposition" }
    }
  ],
  "decisions": [
    {
      "id": "dx",
      "prompt": { "en": "Most likely diagnosis?", "zh-CN": "最可能的诊断？" },
      "requires": { "objective": "assess" },
      "need": { "en": "Assess the airway and allergy history first.", "zh-CN": "先评估气道和过敏史。" },
      "options": [
        { "id": "anaphylaxis", "text": { "en": "Anaphylaxis", "zh-CN": "过敏性休克" }, "correct": true, "feedback": { "en": "Yes.", "zh-CN": "正确。" } },
        { "id": "asthma", "text": { "en": "Acute asthma", "zh-CN": "急性哮喘" }, "correct": false, "feedback": { "en": "No.", "zh-CN": "不对。" } },
        { "id": "panic", "text": { "en": "Panic attack", "zh-CN": "惊恐发作" }, "correct": false, "feedback": { "en": "No.", "zh-CN": "不对。" } }
      ]
    },
    {
      "id": "disposition",
      "kind": "multiple",
      "prompt": { "en": "Select all appropriate disposition steps.", "zh-CN": "选择所有合适的处置。" },
      "requires": { "phase": "observation" },
      "need": { "en": "Stabilise the patient first.", "zh-CN": "先稳定病情。" },
      "options": [
        { "id": "observe", "text": { "en": "Observe for at least 6 hours", "zh-CN": "至少观察6小时" }, "correct": true, "feedback": { "en": "Yes.", "zh-CN": "是。" } },
        { "id": "autoinjector", "text": { "en": "Prescribe adrenaline auto-injectors", "zh-CN": "开具肾上腺素自动注射笔" }, "correct": true, "feedback": { "en": "Yes.", "zh-CN": "是。" } },
        { "id": "discharge-now", "text": { "en": "Discharge now", "zh-CN": "立即出院" }, "correct": false, "feedback": { "en": "No.", "zh-CN": "否。" } },
        { "id": "referral", "text": { "en": "Refer to allergy clinic", "zh-CN": "转诊过敏专科" }, "correct": true, "feedback": { "en": "Yes.", "zh-CN": "是。" } }
      ]
    }
  ],
  "rubric": [
    { "id": "epi-given", "domain": "management", "text": { "en": "Adrenaline given", "zh-CN": "给予肾上腺素" }, "weight": 3, "met": { "intervened": "epi" } },
    { "id": "no-beta", "domain": "safety", "text": { "en": "No beta-blocker", "zh-CN": "未用β受体阻滞剂" }, "weight": 2, "met": { "not": { "intervened": "beta-blocker" } } },
    { "id": "airway", "domain": "examination", "text": { "en": "Airway assessed", "zh-CN": "评估气道" }, "weight": 1, "met": { "examined": "airway" } },
    { "id": "comms", "domain": "communication", "text": { "en": "Reassured the patient", "zh-CN": "安抚患者" }, "weight": 1 }
  ],
  "debrief": {
    "title": { "en": "Debrief", "zh-CN": "复盘" },
    "conclusion": { "en": "Peanut anaphylaxis.", "zh-CN": "花生过敏性休克。" }
  },
  "solution": [
    { "type": "start" },
    { "type": "examine", "findingId": "airway" },
    { "type": "ask", "itemId": "allergies" },
    { "type": "ask", "itemId": "trigger" },
    { "type": "intervene", "interventionId": "epi" },
    { "type": "intervene", "interventionId": "oxygen" },
    { "type": "answer", "decisionId": "dx", "optionIds": ["anaphylaxis"] },
    { "type": "answer", "decisionId": "disposition", "optionIds": ["referral", "observe", "autoinjector"] },
    { "type": "finish" }
  ]
