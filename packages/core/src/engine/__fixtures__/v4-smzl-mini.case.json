      "need": { "zh-CN": "先完成病史、血常规／腹部影像、骨髓活检及流式证据。", "en": "Complete the history, CBC/abdominal imaging, biopsy and flow first." },
      "options": [
        { "id": "metastasis", "text": { "zh-CN": "肺腺癌转移可以解释全部异常", "en": "Metastatic lung cancer explains everything" }, "correct": false, "feedback": { "zh-CN": "不能直接归因。", "en": "Not supported." } },
        { "id": "dual", "text": { "zh-CN": "SMZL伴骨髓侵犯，与肺腺癌并存", "en": "SMZL with marrow involvement plus lung adenocarcinoma" }, "correct": true, "feedback": { "zh-CN": "符合原病例诊断。", "en": "Matches the source diagnosis." } },
        { "id": "infection", "text": { "zh-CN": "单纯感染性脾大", "en": "Infective splenomegaly only" }, "correct": false, "feedback": { "zh-CN": "不能解释。", "en": "Does not explain the clone." } }
      ]
    },
    {
      "id": "safety",
      "prompt": { "zh-CN": "开始抗CD20治疗前，哪项认识更合适？", "en": "Before anti-CD20 therapy, which is most appropriate?" },
      "requires": { "read": "hbv", "phase": "pre" },
      "need": { "zh-CN": "先开具并阅读乙肝筛查／HBV DNA记录。", "en": "Order and read the HBV screen first." },
      "options": [
        { "id": "negative", "text": { "zh-CN": "可以排除再激活风险", "en": "Reactivation risk is excluded" }, "correct": false, "feedback": { "zh-CN": "不能排除。", "en": "It cannot be excluded." } },
        { "id": "assess", "text": { "zh-CN": "制定再激活预防与监测方案", "en": "Plan prophylaxis and monitoring" }, "correct": true, "feedback": { "zh-CN": "正确。", "en": "Correct." } }
      ]
    },
    {
      "id": "genetics",
      "prompt": { "zh-CN": "t(4;12)(q23;q13)支持哪种结论？", "en": "What does t(4;12)(q23;q13) support?" },
      "requires": { "read": "karyo", "phase": "pre" },
      "need": { "zh-CN": "先阅读染色体核型原图及报告。", "en": "Read the karyotype first." },
      "options": [
        { "id": "same", "text": { "zh-CN": "证明共同起源", "en": "Proves a common origin" }, "correct": false, "feedback": { "zh-CN": "不足以证明。", "en": "Insufficient." } },
        { "id": "limited", "text": { "zh-CN": "共同机制仍需验证", "en": "A shared mechanism still needs paired evidence" }, "correct": true, "feedback": { "zh-CN": "正确。", "en": "Correct." } }
      ]
    },
    {
      "id": "response",
      "prompt": { "zh-CN": "治疗后的资料最合理支持什么结论？", "en": "What do the post-treatment data support?" },
      "requires": { "all": [{ "any": [{ "read": "abdct", "phase": "post" }, { "read": "us", "phase": "post" }] }, { "read": "flow", "phase": "post" }] },
      "need": { "zh-CN": "切换到复评期，阅读腹部CT或超声，以及复查流式。", "en": "Switch to the review phase and read imaging plus flow." },
      "options": [
        { "id": "complete", "text": { "zh-CN": "两种肿瘤都已完全缓解", "en": "Both tumours are in complete remission" }, "correct": false, "feedback": { "zh-CN": "不能。", "en": "No." } },
        { "id": "separate", "text": { "zh-CN": "两种肿瘤仍需分别复评", "en": "Both tumours need separate re-evaluation" }, "correct": true, "feedback": { "zh-CN": "正确。", "en": "Correct." } }
      ]
    }
