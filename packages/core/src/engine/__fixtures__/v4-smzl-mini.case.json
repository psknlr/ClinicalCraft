  "orderMatching": {
    "rules": [
      { "ifHas": "pet", "unlessMatches": "腹部|全腹|脾脏|胸腹", "remove": ["abdct"] },
      { "ifHas": "pet", "unlessMatches": "胸部|肺部", "remove": ["chestct"] },
      { "ifHas": "chestct", "unlessMatches": "腹部|全腹|脾脏|胸腹", "remove": ["abdct"] },
      { "ifMatches": "^(?=.*胸腹)(?=.*ct)", "unlessHas": "chestct", "add": ["chestct"] },
      { "ifHas": "nodeus", "remove": ["us"] },
      { "ifMatches": "^(?=.*(心脏|甲状腺|颈动脉|下肢|肾脏|乳腺))(?=.*(超声|彩超|b超))", "remove": ["us"] },
      { "ifMatches": "^(?=.*骨髓穿刺)(?=.*活检)", "unlessHas": "biopsy", "add": ["biopsy"] }
    ],
    "exact": {
      "超声": ["us", "nodeus"],
      "彩超": ["us", "nodeus"],
      "b超": ["us", "nodeus"],
      "ct": ["abdct", "chestct"],
