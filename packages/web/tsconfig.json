{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@clinicalcraft/core": ["../core/src/index.ts"],
      "@clinicalcraft/world": ["../world/src/index.ts"],
      "@clinicalcraft/agent": ["../agent/src/index.ts"],
      "@clinicalcraft/content": ["../content/src/index.ts"],
      "@clinicalcraft/content/*": ["../content/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
